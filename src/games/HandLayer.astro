---
// The translucent presentation hand + ghost layer, placed inside each game board SVG.
// The fingertip is at (0, 0) so the hand can point exactly at a spot.
---
<g data-ghost aria-hidden="true" style="opacity:0"></g>
<g data-hand aria-hidden="true" style="opacity:0">
  <g transform="translate(-58 0) scale(2.4)" fill="#FFE6D2" stroke="rgb(118 61 13 / .55)" stroke-width="2" stroke-linejoin="round">
    <path class="finger2" d="M24 6 Q24 0 30 0 Q36 0 36 6 V40 H24 Z" />
    <path d="M6 44 Q2 36 8 32 L18 40 V6 Q18 0 24 0 Q30 0 30 6 V36 H44 Q54 36 54 46 V64 Q54 82 36 82 H26 Q14 82 10 70 Z" />
    <path d="M30 36 V44 M42 36 V44" fill="none" />
  </g>
</g>
