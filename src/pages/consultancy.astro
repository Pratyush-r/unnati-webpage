---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import ConsultancyVsFranchise from '../components/ConsultancyVsFranchise.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, telHref } from '../config/site';
import { consultancy, consultancyFaq, consultancyWa } from '../content/faq';
---
<BaseLayout
  title="Montessori School Consultancy | Unnati, Chennai"
  description="Montessori school consultancy from Unnati: school setup, environment and materials, teacher training, policy, curriculum, licensing and ongoing mentorship."
>
  <section class="page-hero c-hero">
    <div class="container c-hero-grid">
      <div class="c-hero-text">
        <p class="eyebrow">Unnati Montessori</p>
        <h1>Montessori Consultancy</h1>
        <p class="subhead">Empowering spaces. Inspiring lifelong learning.</p>
        <p class="lead">We partner with passionate educators and entrepreneurs to build authentic Montessori environments that nurture independence, confidence and joy.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={consultancyWa} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp {site.school.display}</a>
          <a class="btn btn--secondary" href={telHref(site.school)}><Icon name="phone" />Call</a>
        </div>
      </div>
      <p class="badge-round"><span>Rooted in Montessori. Designed for your vision.</span></p>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="services">
    <div class="container">
      <SectionHead title="Our consultancy services" id="services" />
      <ol class="services" role="list" data-reveal="children">
        {consultancy.services.map((s, i) => (
          <li class="service">
            <span class:list={['icon-badge', { 'icon-badge--blush': i % 2 === 1 }]}><Icon name={s.icon} /></span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="services-line">{consultancy.servicesLine}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="c-approach">
    <div class="container two-col">
      <div>
        <SectionHead title="How we work with you" id="c-approach" />
        <ul class="approach" role="list" data-reveal="children">
          {consultancy.approach.map((a) => (
            <li><span class="icon-badge"><Icon name={a.icon} /></span><div><h3>{a.title}</h3><p>{a.text}</p></div></li>
          ))}
        </ul>
      </div>
      <div class="who pebble" data-reveal>
        <h2 class="who-title">Who we work with</h2>
        <ul role="list" class="who-list">
          {consultancy.whoWeWorkWith.map((w) => <li><Icon name="star" size={20} />{w}</li>)}
        </ul>
        <p class="hand">Let's build a space where children thrive.</p>
      </div>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="cvf">
    <div class="container">
      <SectionHead title="Build your own school, your way" offset id="cvf" />
      <ConsultancyVsFranchise />
    </div>
  </section>

  <section class="section" aria-labelledby="why-fail">
    <div class="container two-col">
      <div>
        <SectionHead title="Why preschools fail or shut down" id="why-fail" />
        <div class="help pebble" data-reveal>
          <p><strong>We help you</strong> {consultancy.whyFailClose}</p>
        </div>
      </div>
      <ol class="fail-list" role="list" data-reveal="children">
        {consultancy.whyFail.map((f, i) => (
          <li><span class="fail-num">{i + 1}</span><Icon name={f.icon} /><span>{f.text}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="c-faq">
    <div class="container-narrow">
      <SectionHead title="Questions we're often asked" id="c-faq" intro="We say yes to most of them." />
      <Faq items={consultancyFaq} />
    </div>
  </section>

  <CtaBand title="Your vision. Our expertise. A brighter future for children." topic="consultancy" />
</BaseLayout>

<style>
  .c-hero-grid { display: grid; gap: 2rem; align-items: center; }
  .c-hero-text { display: grid; gap: .9rem; justify-items: start; }
  .subhead { font-family: var(--font-head); font-size: var(--fs-h3); color: var(--forest); font-weight: 600; }
  .badge-round {
    justify-self: center; width: 210px; aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; text-align: center;
    background: var(--forest); color: var(--cream); padding: 2rem; font-family: var(--font-head); font-size: 1.25rem; line-height: 1.3;
    box-shadow: 0 0 0 8px var(--cream), 0 0 0 10px color-mix(in srgb, var(--forest) 25%, transparent);
  }
  .services { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .service { display: flex; gap: 1rem; align-items: flex-start; background: var(--cream); border: 1px solid var(--line); border-radius: var(--r-md); padding: 1.1rem; }
  .service h3 { font-size: 1.1875rem; margin-bottom: .25rem; }
  .service p { font-size: .975rem; }
  .services-line { margin: 2rem auto 0; text-align: center; font-family: var(--font-head); font-size: var(--fs-h3); color: var(--brown); max-width: 46ch; }
  .two-col { display: grid; gap: 2rem; }
  .approach { display: grid; gap: 1rem; }
  .approach li { display: flex; gap: 1rem; align-items: flex-start; }
  .approach h3 { font-size: 1.1875rem; margin-bottom: .15rem; }
  .who { background: var(--sage); align-self: start; display: grid; gap: 1rem; }
  .who-title { font-size: var(--fs-h3); color: var(--forest); }
  .who-list { display: grid; gap: .6rem; }
  .who-list li { display: flex; gap: .6rem; align-items: flex-start; font-weight: 700; }
  .who-list :global(svg) { color: var(--brown); flex: none; margin-top: .2rem; }
  .help { background: var(--blush); }
  .fail-list { display: grid; gap: .5rem; counter-reset: none; }
  .fail-list li { display: grid; grid-template-columns: 28px 24px 1fr; gap: .75rem; align-items: center; padding: .7rem 1rem; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-sm); font-weight: 700; }
  .fail-list :global(svg) { color: var(--brown); }
  .fail-num { font-family: var(--font-head); color: var(--leaf); font-weight: 600; font-size: 1.125rem; }
  @media (min-width: 900px) {
    .c-hero-grid { grid-template-columns: 1fr auto; }
    .badge-round { width: 240px; }
    .two-col { grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  }
</style>
