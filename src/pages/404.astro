---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ankur from '../components/Ankur.astro';
---
<BaseLayout title="Page not found | Unnati Montessori" description="This page wandered off. Head back to the home page or Little Hands Corner." noindex>
  <section class="section nf">
    <div class="container-narrow nf-inner">
      <Ankur size={130} class="nf-ankur" />
      <h1>This page wandered off.</h1>
      <p class="lead">Ankur is looking for it too. Let's head back to the shelf.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Home</a>
        <a class="btn btn--secondary" href="/play">Little Hands Corner</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf-inner { display: grid; gap: 1rem; justify-items: center; text-align: center; }
  .nf .btn-row { justify-content: center; margin-top: .5rem; }
</style>

<script>
  import { play } from '../components/ankur';
  import { onPageLoad } from '../scripts/lifecycle';

  onPageLoad(() => {
    const a = document.querySelector('.nf-ankur');
    if (!a) return;
    const t = window.setTimeout(() => play(a, 'look-around'), 400);
    return () => window.clearTimeout(t);
  });
</script>
