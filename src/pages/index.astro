---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PreparedShelf from '../components/PreparedShelf.astro';
import SectionHead from '../components/SectionHead.astro';
import ProgrammeCards from '../components/ProgrammeCards.astro';
import AreaCards from '../components/AreaCards.astro';
import CompareToggle from '../components/CompareToggle.astro';
import FlipCards from '../components/FlipCards.astro';
import FindUsMap from '../components/FindUsMap.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import VineDivider from '../components/VineDivider.astro';
import Doodle from '../components/Doodle.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import { site, statusLabel, siteUrl, wa, waText } from '../config/site';
import { founderExcerpt, homeDidYouKnow } from '../content/copy';

const description =
  'Authentic Montessori House for Children (ages 2½–6) in Mogappair West, Chennai. Primary Environment, Day Care & After-school. Admissions open all year.';

const sameAs = Object.values(site.social).filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Preschool',
  name: site.name,
  alternateName: `${site.name} — ${site.tagline}`,
  description,
  url: `${siteUrl}/`,
  logo: `${siteUrl}/brand/logo-wide-lg@2x.png`,
  image: `${siteUrl}/og/default.png`,
  telephone: site.school.tel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.street}, ${site.address.area}`,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  founder: { '@type': 'Person', name: site.contactPerson },
  ...(sameAs.length ? { sameAs } : {}),
};
---
<BaseLayout title="Unnati Montessori | Montessori Preschool in Mogappair West" description={description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{site.tagline} · Ages {site.primary.ages} · {site.address.area}, {site.address.city}</p>
        <h1>Help me do it <span class="scribble">myself.</span></h1>
        <p class="lead">
          Unnati Montessori is an authentic Montessori environment where children grow into independent, confident and compassionate learners — at their own pace.
        </p>
        <p class="chip status circled"><span class="dot" aria-hidden="true"></span>{statusLabel} · Admissions open all year</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={wa(site.school, waText.general)} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp us</a>
          <a class="btn btn--secondary" href="/approach">Explore our approach</a>
        </div>
      </div>
      <div class="hero-shelf">
        <Doodle kind="sun" size={64} class="d-sun" wideOnly />
        <Doodle kind="star" size={30} class="d-star" />
        <PreparedShelf />
      </div>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="programmes-title">
    <div class="container">
      <Doodle kind="sprout" size={56} class="d-sprout" wideOnly />
      <SectionHead title="A Montessori preschool in Mogappair West" mark="preschool" offset id="programmes-title"
        intro={`A Primary Environment for ages ${site.primary.ages}, ${site.dayCare.name} from age 1, and after-school activities — all guided by the same Montessori values.`} />
      <ProgrammeCards />
    </div>
  </section>

  <section class="section" aria-labelledby="areas-title">
    <div class="container">
      <SectionHead title="Five areas, one prepared environment" mark="prepared environment" id="areas-title"
        intro="Every material on a Montessori shelf belongs to one of five areas. Each has a short activity in Little Hands Corner, built on a real classroom material." />
      <AreaCards />
      <p class="more-link"><a class="btn btn--primary" href="/play">Visit Little Hands Corner <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section bg-blush" aria-labelledby="compare-title">
    <div class="container">
      <SectionHead title="Montessori or traditional education?" id="compare-title" center />
      <CompareToggle id="home-compare" />
    </div>
  </section>

  <section class="section" aria-labelledby="dyk-title">
    <div class="container">
      <Doodle kind="swirl" size={52} class="d-swirl" wideOnly />
      <SectionHead title="Small things that make a Montessori classroom" mark="Small things" offset id="dyk-title"
        intro="Tap a card to turn it over." />
      <FlipCards ids={homeDidYouKnow} />
      <p class="more-link"><a class="text-link" href="/approach#did-you-know">See all 10 <span aria-hidden="true">&nbsp;→</span></a></p>
    </div>
  </section>

  <section class="section--tight founder-band" aria-labelledby="founder-title">
    <div class="container-narrow">
      <VineDivider />
      <figure class="founder pebble tape tape--sage" data-reveal>
        <Doodle kind="heart" size={34} class="d-heart" />
        <h2 id="founder-title" class="sr-only">From our founder</h2>
        <blockquote><p>“{founderExcerpt}”</p></blockquote>
        <figcaption>
          <strong>— {site.contactPerson}, Founder</strong>
          <span>AMI Montessori educator, 10+ years</span>
        </figcaption>
        <a class="btn btn--secondary" href="/about">Read our story</a>
      </figure>
    </div>
  </section>

  <PhotoStrip headingId="home-photos" />

  <section class="section bg-paper" aria-labelledby="find-us">
    <div class="container">
      <SectionHead title="Visit us in Mogappair West" mark="Mogappair West" id="find-us" />
      <FindUsMap headingId="home-map" />
    </div>
  </section>

  <EnquiryForm />
</BaseLayout>

<style>
  .hero { padding-block: clamp(1.75rem, 1rem + 3vw, 4rem) clamp(2.5rem, 2rem + 3vw, 4.5rem); overflow: hidden; }
  .hero-grid { display: grid; gap: 1.5rem; align-items: center; }
  .hero-text { display: grid; gap: 1rem; justify-items: start; }
  .hero-text h1 { margin-top: .1rem; }
  .status { margin-top: .25rem; }
  .hero-text .btn-row { margin-top: .5rem; }
  .hero-shelf { position: relative; padding-bottom: .5rem; }
  .hero-shelf :global(.d-sun) { top: -6px; left: 2%; }
  .hero-shelf :global(.d-star) { right: 3%; bottom: 8%; }
  .hero-text h1 { position: relative; }
  .container { position: relative; }
  :global(.d-sprout) { right: 2%; top: -1.25rem; }
  :global(.d-swirl) { right: 6%; top: 0; }
  .founder :global(.d-heart) { right: 18px; bottom: 16px; color: var(--leaf); }
  .more-link { margin-top: 1.75rem; }
  .founder-band { background: var(--cream); }
  .founder {
    position: relative; margin: 2.25rem auto 0; max-width: 680px; text-align: center; display: grid; gap: 1rem; justify-items: center;
    padding: clamp(1.75rem, 1.25rem + 2vw, 2.75rem) clamp(1.25rem, 1rem + 2vw, 2.5rem);
  }
  @media (min-width: 768px) { .founder { rotate: -1.2deg; } }
  .founder blockquote { margin: 0; }
  .founder blockquote p { font-family: var(--font-head); font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2.1rem); line-height: 1.3; color: var(--brown); max-width: 30ch; margin-inline: auto; font-weight: 500; }
  .founder figcaption { display: grid; gap: .1rem; }
  .founder figcaption span { color: rgb(59 36 20 / .8); }
  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: 1fr 1.05fr; gap: 3rem; }
  }
</style>
