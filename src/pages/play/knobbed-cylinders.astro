---
// Game 2 — Knobbed Cylinders · Sensorial. A natural-wood block with 5 graded holes; 5 cylinders on a felt mat.
import GameLayout from '../../layouts/GameLayout.astro';
import HandLayer from '../../games/HandLayer.astro';

const O = 'rgb(118 61 13 / .7)';
const SIZES = [110, 140, 170, 200, 230];
const NAMES = ['smallest', 'small', 'middle', 'big', 'biggest'];
---
<GameLayout slug="knobbed-cylinders" title="Knobbed Cylinders" area="Sensorial" doneText="Every cylinder is home."
  description="A Sensorial activity for children aged 2½–6: find each wooden cylinder's own hole in the block.">
  <div class="board">
    <svg data-board-svg role="application" aria-label="Knobbed cylinders: a wooden block with five holes, and five cylinders on a green mat">
      <g data-static="mat">
        <rect class="mat-l" x="-550" y="-185" width="1100" height="370" rx="34" fill="var(--felt)" stroke={O} stroke-width="3" />
        <rect class="mat-p" x="-220" y="-550" width="440" height="1100" rx="34" fill="var(--felt)" stroke={O} stroke-width="3" />
      </g>
      <g data-static="block">
        <rect class="block-l" x="-550" y="-150" width="1100" height="300" rx="26" fill="var(--wood)" stroke={O} stroke-width="3" />
        <path class="block-l" d="M-520 -110 C-200 -125 200 -95 520 -115 M-520 112 C-200 98 200 125 520 108" fill="none" stroke="var(--wood-grain)" stroke-width="3" stroke-linecap="round" />
        <rect class="block-p" x="-130" y="-550" width="260" height="1100" rx="26" fill="var(--wood)" stroke={O} stroke-width="3" />
        <path class="block-p" d="M-100 -520 C-115 -200 -90 200 -108 520 M100 -520 C88 -200 112 200 96 520" fill="none" stroke="var(--wood-grain)" stroke-width="3" stroke-linecap="round" />
      </g>
      <g data-targets>
        {SIZES.map((d, i) => (
          <g data-t={i}>
            <g class="shim">
              <circle r={d / 2 + 3} fill="#8A5A2E" stroke={O} stroke-width="2" />
              <circle r={d / 2 - 4} fill="#6B4322" />
              <path d={`M${-d / 2 + 8} 4 A${d / 2 - 8} ${d / 2 - 8} 0 0 0 ${d / 2 - 8} 4`} fill="none" stroke="#A9773F" stroke-width="3" opacity=".6" />
              <circle r={Math.max(80, d / 2 + 18)} class="target-hl" />
            </g>
          </g>
        ))}
      </g>
      <g data-pieces>
        {SIZES.map((d, i) => {
          const k = Math.max(15, d * 0.13);
          return (
            <g data-p={i} data-size={d} data-name={NAMES[i]}>
              <g class="lift">
                <circle class="hit" r={Math.max(80, d / 2 + 6)} fill="transparent" />
                <circle cx="5" cy="8" r={d / 2} fill="rgb(59 36 20 / .16)" />
                <circle r={d / 2} fill="var(--wood)" stroke={O} stroke-width="3" />
                <circle r={d / 2 - 9} fill="none" stroke="#F1D6B1" stroke-width="3" opacity=".9" />
                <path d={`M${-d * 0.3} ${-d * 0.12} C${-d * 0.1} ${-d * 0.2} ${d * 0.1} ${-d * 0.05} ${d * 0.3} ${-d * 0.14} M${-d * 0.28} ${d * 0.16} C${-d * 0.05} ${d * 0.08} ${d * 0.12} ${d * 0.24} ${d * 0.3} ${d * 0.14}`} fill="none" stroke="var(--wood-grain)" stroke-width="2.5" stroke-linecap="round" />
                <g class="knob">
                  <circle cx="2" cy="4" r={k} fill="rgb(59 36 20 / .2)" />
                  <circle r={k} fill="#C99766" stroke={O} stroke-width="2.5" />
                  <circle cx={-k / 3} cy={-k / 3} r={k / 3} fill="#F3D9B5" />
                </g>
              </g>
            </g>
          );
        })}
      </g>
      <HandLayer />
    </svg>
  </div>
</GameLayout>

<style>
  :global(svg[data-layout='portrait'] .mat-l), :global(svg[data-layout='portrait'] .block-l),
  :global(svg[data-layout='landscape'] .mat-p), :global(svg[data-layout='landscape'] .block-p) { display: none; }
  :global(.knob) { transform-box: fill-box; transform-origin: center; }
</style>

<script>
  import '../../games/knobbed-cylinders';
</script>
