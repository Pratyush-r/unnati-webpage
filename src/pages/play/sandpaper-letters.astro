---
// Game 3 — Sandpaper Letters · Language. Consonants on pink boards, vowels on blue, as in the classroom.
import fs from 'node:fs';
import path from 'node:path';
import GameLayout from '../../layouts/GameLayout.astro';
import HandLayer from '../../games/HandLayer.astro';
import Icon from '../../components/Icon.astro';
import PictureCards from '../../games/PictureCards.astro';
import { LETTERS } from '../../games/letters';

// Build-time manifest of recorded phonetic sounds (public/audio/sounds/{letter}.mp3). Missing files are skipped.
const soundDir = path.join(process.cwd(), 'public', 'audio', 'sounds');
const sounds = LETTERS.map((l) => l.letter).filter((l) => fs.existsSync(path.join(soundDir, `${l}.mp3`)));
const O = 'rgb(118 61 13 / .7)';
---
<GameLayout slug="sandpaper-letters" title="Sandpaper Letters" area="Language" doneText="You traced every letter."
  description="A Language activity for children aged 2½–6: trace sandpaper letters with a finger, the Montessori way.">
  <div class="board">
    <svg data-board-svg data-sounds={sounds.join(',')} aria-label="Sandpaper letter board">
      <defs>
        <filter id="sand" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="n" />
          <feColorMatrix in="n" type="matrix" values="0 0 0 0 0.3  0 0 0 0 0.22  0 0 0 0 0.14  0 0 0 .7 0" result="g" />
          <feComposite in="g" in2="SourceGraphic" operator="in" result="gi" />
          <feMerge><feMergeNode in="SourceGraphic" /><feMergeNode in="gi" /></feMerge>
        </filter>
      </defs>
      <g data-static="card">
        <rect class="board-card" x="-240" y="-300" width="480" height="600" rx="34" stroke={O} stroke-width="3" />
        <g data-letter role="button" tabindex="0" aria-label="Trace the letter. Press Space to trace."></g>
      </g>
      <g data-static="picture" class="picture" style="opacity:0">
        <rect x="-170" y="-170" width="340" height="340" rx="30" fill="var(--paper)" stroke={O} stroke-width="3" />
        <PictureCards />
      </g>
      <HandLayer />
    </svg>
  </div>
  <nav class="letters-nav" aria-label="Letters">
    <button type="button" class="nav-arrow" data-prev aria-label="Previous letter"><Icon name="chevron-left" size={36} /></button>
    <div class="chips" role="list">
      {LETTERS.map((l, i) => (
        <div role="listitem">
          <button type="button" class:list={['chip-l', l.vowel ? 'is-vowel' : 'is-consonant']} data-chip={i} aria-label={`Letter ${l.letter}, ${l.word}`}>
            <span aria-hidden="true">{l.letter}</span>
            <svg class="tick" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z" fill="var(--leaf)" /></svg>
          </button>
        </div>
      ))}
    </div>
    <button type="button" class="nav-arrow" data-next aria-label="Next letter"><Icon name="chevron-right" size={36} /></button>
  </nav>
</GameLayout>

<style>
  :global(.board-card) { fill: var(--pink-board); transition: fill 200ms ease; }
  :global(.is-vowel-card .board-card) { fill: var(--blue-board); }
  :global(.sand) { fill: none; stroke: #B79C7F; stroke-linecap: round; stroke-linejoin: round; filter: url(#sand); }
  :global(.trail) { fill: none; stroke: #6E5640; stroke-linecap: round; stroke-linejoin: round; opacity: .85; }
  :global(.start-dot) { fill: var(--leaf); stroke: #fff; stroke-width: 1.5; }
  :global(.dir-arrow) { fill: var(--leaf); stroke: #fff; stroke-width: .8; stroke-linejoin: round; }
  :global(.i-dot) { fill: #B79C7F; filter: url(#sand); }
  :global(.i-dot.is-done) { fill: #6E5640; filter: none; }
  :global(.i-dot-ring) { fill: none; stroke: var(--leaf); stroke-width: 2; stroke-dasharray: 2 3; opacity: 0; }
  :global(.dot-active .i-dot-ring) { opacity: 1; }
  :global([data-letter]) { outline: none; cursor: pointer; }
  :global([data-letter]:focus-visible) { filter: drop-shadow(0 0 3px #0F692F) drop-shadow(0 0 3px #0F692F); }
  :global(.picture .pic) { display: none; }
  :global(.picture .pic.is-on) { display: inline; }
  :global(.picture) { transform-box: fill-box; }
  .letters-nav { flex: none; display: flex; align-items: center; gap: 8px; padding: 6px 10px calc(8px + env(safe-area-inset-bottom)); }
  .nav-arrow {
    flex: none; display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%;
    background: var(--paper); border: 2px solid var(--line-strong); color: var(--brown); transition: transform 180ms var(--ease-pop);
  }
  .nav-arrow:active { transform: scale(.94); }
  .chips { flex: 1; min-width: 0; display: flex; gap: 8px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x proximity; padding: 4px 2px; justify-content: safe center; scrollbar-width: none; }
  .chips::-webkit-scrollbar { display: none; }
  .chip-l {
    position: relative; flex: none; width: 64px; height: 64px; border-radius: 16px; scroll-snap-align: center;
    font: 700 2rem/1 var(--font-body); color: var(--ink); border: 3px solid transparent; transition: transform 180ms var(--ease-pop);
  }
  .chip-l:active { transform: scale(.94); }
  .chip-l.is-consonant { background: var(--pink-board); }
  .chip-l.is-vowel { background: var(--blue-board); }
  .chip-l[aria-current='true'] { border-color: var(--brown); }
  .chip-l .tick { position: absolute; right: 3px; top: 3px; display: none; }
  .chip-l.is-traced .tick { display: block; }
  :global(.game-ankur) { bottom: 92px !important; }
  @media (orientation: landscape) and (max-height: 500px) {
    :global(.game-main) { flex-direction: row !important; }
    .letters-nav { flex-direction: column; width: 84px; padding: 6px; }
    .chips { flex-direction: column; overflow-x: hidden; overflow-y: auto; }
    :global(.game-ankur) { bottom: 8px !important; right: 92px !important; }
  }
</style>

<script>
  import '../../games/sandpaper-letters';
</script>
