---
// Game 4 — Spindle Box · Mathematics. One compartment with a numeral on its back panel, and a basket of 10 spindles.
import GameLayout from '../../layouts/GameLayout.astro';
import HandLayer from '../../games/HandLayer.astro';

const O = 'rgb(118 61 13 / .7)';
---
<GameLayout title="Spindle Box" area="Mathematics" doneText="You counted them all."
  description="A Mathematics activity for children aged 2½–6: put the right number of wooden spindles in the box.">
  <div class="board">
    <svg data-board-svg role="application" aria-label="Spindle box: a box with a number on it, and a basket of spindles">
      <defs>
        <g id="spindle">
          <path d="M0 -150 C8 -140 13 -110 13 -60 V60 C13 110 8 140 0 150 C-8 140 -13 110 -13 60 V-60 C-13 -110 -8 -140 0 -150 Z" fill="#EBCB9C" stroke={O} stroke-width="2.5" />
          <path d="M-4 -100 C-2 -40 -6 40 -3 100" fill="none" stroke="#F8E3C2" stroke-width="3" stroke-linecap="round" />
        </g>
      </defs>

      <g data-static="progress" aria-hidden="true">
        {[0, 1, 2, 3, 4].map((i) => (
          <path class="pdot" data-pdot={i} transform={`translate(${(i - 2) * 46} 0)`} d="M-14 12 C-14 -4 -2 -14 14 -14 C14 2 2 12 -14 12 Z" />
        ))}
      </g>

      <g data-zone="box" class="zone" role="button" tabindex="0" aria-label="Spindle box">
        <g class="shim">
          <rect x="-230" y="-300" width="460" height="130" rx="18" fill="#EBCDA6" stroke={O} stroke-width="3" />
          <text class="numeral" y="-196" text-anchor="middle" data-numeral>4</text>
          <rect x="-230" y="-180" width="460" height="420" rx="22" fill="var(--wood)" stroke={O} stroke-width="3" />
          <rect x="-200" y="-152" width="400" height="366" rx="14" fill="#D3A46E" />
          <path d="M-190 -60 C-60 -70 60 -50 190 -64 M-190 120 C-60 110 60 130 190 116" fill="none" stroke="var(--wood-grain)" stroke-width="3" opacity=".7" />
          <rect x="-250" y="-320" width="500" height="580" rx="30" class="target-hl" />
        </g>
        <g data-box-spindles></g>
        <path data-ribbon class="ribbon" d="" pathLength="100" />
      </g>

      <g data-zone="basket" class="zone" role="button" tabindex="0" aria-label="Basket of spindles">
        <g class="shim">
          <ellipse cy="-120" rx="200" ry="40" fill="#C99766" stroke={O} stroke-width="3" />
          <g data-basket-spindles></g>
          <path d="M-200 -120 L-170 120 Q-165 140 -140 140 H140 Q165 140 170 120 L200 -120" fill="#D9A866" stroke={O} stroke-width="3" />
          <path d="M-190 -60 H190 M-182 0 H182 M-176 60 H176 M-120 -120 L-110 140 M-40 -120 L-36 140 M40 -120 L36 140 M120 -120 L110 140" stroke="#B8844A" stroke-width="5" opacity=".7" />
          <rect x="-230" y="-220" width="460" height="390" rx="30" class="target-hl" />
        </g>
      </g>

      <g data-done-row></g>
      <g data-held class="held-spindle" style="opacity:0" aria-hidden="true"><use href="#spindle" /></g>
      <HandLayer />
    </svg>
  </div>
</GameLayout>

<style>
  :global(.numeral) { font: 600 120px var(--font-head); fill: var(--brown); }
  :global(.pdot) { fill: transparent; stroke: var(--leaf); stroke-width: 3; }
  :global(.pdot.is-done) { fill: var(--leaf); }
  :global(.ribbon) { fill: none; stroke: var(--leaf); stroke-width: 12; stroke-linecap: round; stroke-dasharray: 100 200; stroke-dashoffset: 101; }
  :global(.zone) { cursor: pointer; outline: none; }
  :global(.zone.is-candidate .target-hl), :global(.zone:focus-visible .target-hl) { opacity: .8; }
  :global(.held-spindle) { pointer-events: none; }
  :global(.held-spindle use) { filter: drop-shadow(0 10px 6px rgb(118 61 13 / .3)); }
  :global(svg.is-finale [data-zone]) { display: none; }
  :global(.bundle-num) { font: 600 64px var(--font-head); fill: var(--brown); }
</style>

<script>
  import '../../games/spindle-box';
</script>
