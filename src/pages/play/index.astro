---
// Little Hands Corner — five short activities, one per Montessori curriculum area.
import BaseLayout from '../../layouts/BaseLayout.astro';
import MaterialArt from '../../components/illustrations/MaterialArt.astro';
import Icon from '../../components/Icon.astro';
import { areas } from '../../content/copy';

type Kind = 'practical' | 'sensorial' | 'language' | 'maths' | 'cultural';
---
<BaseLayout
  title="Little Hands Corner | Montessori Activities for Ages 2½–6"
  description="Five short Montessori activities for little hands — Set the Table, Knobbed Cylinders, Sandpaper Letters, Spindle Box and Land, Air & Water. No ads."
  quiet
>
  <section class="page-hero">
    <div class="container">
      <h1>Little <span class="scribble">Hands</span> Corner</h1>
      <p class="play-sub">For children aged 2½–6, with a grown-up.</p>
      <div class="grownups pebble">
        <p class="g-title"><Icon name="people" size={22} /> A note for grown-ups</p>
        <p>Montessori learning happens with real materials and real hands. These five short activities are a gentle peek into our classroom — best enjoyed together, a few minutes at a time.</p>
        <p class="small">No ads. No scores. Nothing is collected.</p>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <ul class="games" role="list">
        {areas.map((a) => (
          <li>
            <a class="game-card" href={a.href} style={`--tint:${a.tint}`}>
              <span class="g-art" transition:name={`game-${a.href.split('/').pop()}`}><MaterialArt kind={a.id as Kind} size={150} /></span>
              <span class="g-area">{a.name}</span>
              <span class="g-name">{a.game}</span>
              <span class="g-play"><Icon name="play" size={30} /> Play</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .play-sub { margin-top: .5rem; font-size: var(--fs-lead); font-weight: 700; color: var(--brown); }
  .grownups { margin-top: 1.25rem; max-width: 760px; background: var(--paper); display: grid; gap: .5rem; }
  .g-title { display: flex; align-items: center; gap: .5rem; font-weight: 800; color: var(--forest); }
  .small { font-weight: 700; color: var(--brown); }
  .games { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); padding-bottom: 3rem; }
  .game-card {
    display: grid; justify-items: center; gap: .35rem; text-align: center; text-decoration: none; color: var(--ink);
    background: var(--tint); border: 1px solid var(--line); border-radius: var(--r-pebble); box-shadow: var(--shadow);
    padding: 1.5rem 1.25rem 1.25rem; height: 100%;
    transition: transform 200ms var(--ease-move), box-shadow 200ms var(--ease-move);
  }
  .game-card:active { transform: scale(.98); }
  @media (pointer: fine) { .game-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); } }
  .g-art { display: grid; place-items: center; width: 180px; height: 170px; background: rgb(255 250 242 / .7); border-radius: 50%; margin-bottom: .5rem; }
  .g-area { font-weight: 800; font-size: .8125rem; letter-spacing: .1em; text-transform: uppercase; color: var(--leaf); }
  .g-name { font-family: var(--font-head); font-weight: 600; font-size: 1.5rem; color: var(--brown); line-height: 1.2; }
  .g-play {
    margin-top: .75rem; display: inline-flex; align-items: center; gap: .5rem; min-height: 64px; padding: 0 1.75rem; border-radius: 999px;
    background: var(--forest); color: var(--cream); font-weight: 800; font-size: 1.125rem;
  }
</style>
