---
// Game 1 — Set the Table · Practical Life. A Montessori placemat with dotted outlines, set for an Indian table.
import GameLayout from '../../layouts/GameLayout.astro';
import HandLayer from '../../games/HandLayer.astro';

const O = 'rgb(118 61 13 / .7)';
---
<GameLayout slug="set-the-table" title="Set the Table" area="Practical Life" doneText="The table is ready."
  description="A Practical Life activity for children aged 2½–6: put the plate, katori, tumbler, spoon and napkin on their shapes.">
  <div class="board">
    <svg data-board-svg aria-label="Set the table: a placemat with shapes, and a tray of things to put on them" role="application">
      <defs>
        <pattern id="cloth" width="24" height="24" patternUnits="userSpaceOnUse">
          <rect width="24" height="24" fill="#FBEBDC" />
          <path d="M0 12 H24 M12 0 V24" stroke="#F3D9C2" stroke-width="2" />
        </pattern>
        <linearGradient id="steel" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#EEF2F5" /><stop offset=".55" stop-color="#C9D2D9" /><stop offset="1" stop-color="#E3E8EC" />
        </linearGradient>
      </defs>

      <!-- Table -->
      <g data-static="table">
        <rect x="-370" y="-340" width="740" height="680" rx="26" fill="var(--wood)" stroke={O} stroke-width="3" />
        <path d="M-330 -250 C-150 -270 60 -230 330 -260 M-340 -60 C-120 -80 140 -40 340 -70 M-330 150 C-110 130 120 170 330 140 M-320 290 C-100 270 120 300 320 280" fill="none" stroke="var(--wood-grain)" stroke-width="3" stroke-linecap="round" opacity=".8" />
      </g>
      <!-- Placemat with dotted outlines -->
      <g data-static="mat">
        <rect x="-340" y="-230" width="680" height="460" rx="28" fill="url(#cloth)" stroke={O} stroke-width="3" />
        <rect x="-322" y="-212" width="644" height="424" rx="20" fill="none" stroke="#D6905E" stroke-width="3" stroke-dasharray="10 8" />
      </g>

      <g data-targets>
        <g data-t="plate"><g class="shim"><circle r="86" class="outline" /><circle r="110" class="target-hl" /></g></g>
        <g data-t="katori"><g class="shim"><circle r="53" class="outline" /><circle r="80" class="target-hl" /></g></g>
        <g data-t="tumbler"><g class="shim"><path d="M-40 -56 H40 L33 56 H-33 Z" class="outline" /><rect x="-80" y="-82" width="160" height="164" rx="30" class="target-hl" /></g></g>
        <g data-t="spoon"><g class="shim"><path d="M0 -88 C22 -88 24 -52 10 -34 L8 84 Q0 92 -8 84 L-10 -34 C-24 -52 -22 -88 0 -88 Z" class="outline" /><rect x="-80" y="-110" width="160" height="220" rx="40" class="target-hl" /></g></g>
        <g data-t="napkin"><g class="shim"><rect x="-50" y="-70" width="100" height="140" rx="8" class="outline" /><rect x="-80" y="-94" width="160" height="188" rx="24" class="target-hl" /></g></g>
      </g>

      <!-- Trays (one per layout) -->
      <g data-static="tray-l" data-only="landscape">
        <rect x="-190" y="-340" width="380" height="680" rx="36" fill="#D9AE7A" stroke={O} stroke-width="3" />
        <rect x="-166" y="-316" width="332" height="632" rx="24" fill="var(--wood)" />
        <path d="M-150 -200 C-60 -210 60 -190 150 -205 M-150 60 C-60 50 60 70 150 55" fill="none" stroke="var(--wood-grain)" stroke-width="3" opacity=".7" />
      </g>
      <g data-static="tray-p" data-only="portrait">
        <rect x="-370" y="-230" width="740" height="460" rx="36" fill="#D9AE7A" stroke={O} stroke-width="3" />
        <rect x="-346" y="-206" width="692" height="412" rx="24" fill="var(--wood)" />
        <path d="M-320 -100 C-100 -110 120 -90 320 -105 M-320 110 C-100 100 120 120 320 105" fill="none" stroke="var(--wood-grain)" stroke-width="3" opacity=".7" />
      </g>

      <!-- Flower vase (appears on completion) -->
      <g data-static="vase" class="vase" opacity="0">
        <g class="vase-art">
          <path d="M0 -40 C-10 -70 -30 -80 -40 -96" fill="none" stroke="#2E8540" stroke-width="5" stroke-linecap="round" />
          <path d="M0 -40 C4 -80 6 -96 4 -116" fill="none" stroke="#2E8540" stroke-width="5" stroke-linecap="round" />
          <path d="M0 -40 C14 -64 30 -74 42 -90" fill="none" stroke="#2E8540" stroke-width="5" stroke-linecap="round" />
          <g fill="#F2A33A" stroke={O} stroke-width="2"><circle cx="-40" cy="-100" r="16" /><circle cx="44" cy="-94" r="16" /></g>
          <circle cx="4" cy="-122" r="18" fill="#F4B5C4" stroke={O} stroke-width="2" />
          <g fill="#C2410C"><circle cx="-40" cy="-100" r="6" /><circle cx="44" cy="-94" r="6" /><circle cx="4" cy="-122" r="7" /></g>
          <path d="M-22 -40 H22 L28 0 C30 30 20 44 0 44 C-20 44 -30 30 -28 0 Z" fill="var(--blue-board)" stroke={O} stroke-width="3" />
        </g>
      </g>

      <!-- Pieces -->
      <g data-pieces>
        <g data-p="plate"><g class="lift">
          <rect class="hit" fill="transparent" x="-95" y="-95" width="190" height="190" />
          <circle r="85" fill="url(#steel)" stroke={O} stroke-width="3" />
          <circle r="60" fill="#E7ECEF" stroke="#B8C2CA" stroke-width="2" />
          <path d="M-50 -48 A70 70 0 0 1 20 -66" fill="none" stroke="#fff" stroke-width="8" stroke-linecap="round" opacity=".8" />
        </g></g>
        <g data-p="katori"><g class="lift">
          <rect class="hit" fill="transparent" x="-80" y="-80" width="160" height="160" />
          <circle r="52" fill="url(#steel)" stroke={O} stroke-width="3" />
          <circle r="38" fill="#B9C3CB" />
          <path d="M-30 -24 A40 40 0 0 1 10 -40" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" opacity=".8" />
        </g></g>
        <g data-p="tumbler"><g class="lift">
          <rect class="hit" fill="transparent" x="-80" y="-80" width="160" height="160" />
          <path d="M-40 -55 H40 L33 55 Q32 60 26 60 H-26 Q-32 60 -33 55 Z" fill="url(#steel)" stroke={O} stroke-width="3" />
          <ellipse cy="-55" rx="40" ry="10" fill="#DCE3E8" stroke={O} stroke-width="3" />
          <path d="M-24 -36 L-19 44" stroke="#fff" stroke-width="7" stroke-linecap="round" opacity=".75" />
        </g></g>
        <g data-p="spoon"><g class="lift">
          <rect class="hit" fill="transparent" x="-80" y="-100" width="160" height="200" />
          <path d="M0 -88 C22 -88 24 -52 10 -34 L8 84 Q0 92 -8 84 L-10 -34 C-24 -52 -22 -88 0 -88 Z" fill="url(#steel)" stroke={O} stroke-width="3" />
          <path d="M-6 -76 C-12 -66 -10 -54 -4 -48" stroke="#fff" stroke-width="5" fill="none" stroke-linecap="round" opacity=".8" />
        </g></g>
        <g data-p="napkin"><g class="lift">
          <rect class="hit" fill="transparent" x="-80" y="-85" width="160" height="170" />
          <rect x="-50" y="-70" width="100" height="140" rx="8" fill="#F6C9A6" stroke={O} stroke-width="3" />
          <rect x="-40" y="-60" width="80" height="120" rx="4" fill="none" stroke="#7FAF6A" stroke-width="4" stroke-dasharray="8 6" />
          <path d="M-50 -10 H50" stroke="rgb(118 61 13 / .35)" stroke-width="3" />
        </g></g>
      </g>
      <HandLayer />
    </svg>
  </div>
</GameLayout>

<style>
  :global(.outline) { fill: rgb(255 255 255 / .45); stroke: var(--brown); stroke-width: 4; stroke-dasharray: 3 11; stroke-linecap: round; transition: opacity 400ms ease; }
  :global(svg[data-layout='portrait'] [data-only='landscape']), :global(svg[data-layout='landscape'] [data-only='portrait']) { display: none; }
  :global(.is-set .outline) { opacity: 0; }
  :global(.vase-art) { transform-box: fill-box; transform-origin: 50% 100%; }
</style>

<script>
  import '../../games/set-the-table';
</script>
