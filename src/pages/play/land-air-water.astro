---
// Game 5 — Land, Air & Water · Cultural Studies. Three picture trays; 9 picture cards, one at a time.
import GameLayout from '../../layouts/GameLayout.astro';
import HandLayer from '../../games/HandLayer.astro';

const O = 'rgb(118 61 13 / .7)';
const INK = '#3B2414';
const CARDS = [
  { id: 'elephant', home: 'land', label: 'elephant' },
  { id: 'cow', home: 'land', label: 'cow' },
  { id: 'auto', home: 'land', label: 'auto-rickshaw' },
  { id: 'fish', home: 'water', label: 'fish' },
  { id: 'dolphin', home: 'water', label: 'dolphin' },
  { id: 'boat', home: 'water', label: 'kattumaram fishing boat' },
  { id: 'parrot', home: 'air', label: 'parrot' },
  { id: 'plane', home: 'air', label: 'aeroplane' },
  { id: 'kite', home: 'air', label: 'kite' },
];
---
<GameLayout title="Land, Air & Water" area="Cultural Studies" doneText="Everything has found its place."
  description="A Cultural Studies activity for children aged 2½–6: does it live or travel on land, in water or in the air?">
  <div class="board">
    <svg data-board-svg role="application" aria-label="Land, air and water: three trays and a deck of picture cards">
      <!-- Trays -->
      <g data-t="land"><g class="shim">
        <rect class="tray tray-l" x="-180" y="-160" width="360" height="320" rx="30" fill="#E7D3AE" stroke={O} stroke-width="3" />
        <rect class="tray tray-l" x="-160" y="-60" width="320" height="200" rx="20" fill="var(--land)" />
        <rect class="tray tray-p" x="-350" y="-110" width="700" height="220" rx="30" fill="#E7D3AE" stroke={O} stroke-width="3" />
        <rect class="tray tray-p" x="-200" y="-92" width="532" height="184" rx="20" fill="var(--land)" />
        <g class="tray-icon">
          <path d="M-40 18 C-42 -6 -36 -20 -30 -30 M-20 18 C-20 -12 -12 -26 -2 -36 M0 18 C2 -10 12 -22 24 -28 M20 18 C24 -4 34 -14 44 -18" fill="none" stroke="#3F8F55" stroke-width="7" stroke-linecap="round" />
          <path d="M-56 18 H56" stroke="#8B5A2B" stroke-width="10" stroke-linecap="round" />
          <text class="tray-label" y="54" text-anchor="middle">Land</text>
        </g>
        <rect class="target-hl tray-l" x="-196" y="-176" width="392" height="352" rx="40" />
        <rect class="target-hl tray-p" x="-366" y="-126" width="732" height="252" rx="40" />
      </g></g>
      <g data-t="water"><g class="shim">
        <rect class="tray tray-l" x="-180" y="-160" width="360" height="320" rx="30" fill="#CFE3EE" stroke={O} stroke-width="3" />
        <rect class="tray tray-l" x="-160" y="-60" width="320" height="200" rx="20" fill="var(--water)" />
        <rect class="tray tray-p" x="-350" y="-110" width="700" height="220" rx="30" fill="#CFE3EE" stroke={O} stroke-width="3" />
        <rect class="tray tray-p" x="-200" y="-92" width="532" height="184" rx="20" fill="var(--water)" />
        <g class="tray-icon">
          <path d="M-56 -4 C-44 -20 -32 -20 -20 -4 S4 12 16 -4 S40 -20 56 -4 M-56 18 C-44 2 -32 2 -20 18 S4 34 16 18 S40 2 56 18" fill="none" stroke="#2F6FB0" stroke-width="7" stroke-linecap="round" />
          <text class="tray-label" y="54" text-anchor="middle">Water</text>
        </g>
        <rect class="target-hl tray-l" x="-196" y="-176" width="392" height="352" rx="40" />
        <rect class="target-hl tray-p" x="-366" y="-126" width="732" height="252" rx="40" />
      </g></g>
      <g data-t="air"><g class="shim">
        <rect class="tray tray-l" x="-180" y="-160" width="360" height="320" rx="30" fill="#E6F1F8" stroke={O} stroke-width="3" />
        <rect class="tray tray-l" x="-160" y="-60" width="320" height="200" rx="20" fill="var(--air)" />
        <rect class="tray tray-p" x="-350" y="-110" width="700" height="220" rx="30" fill="#E6F1F8" stroke={O} stroke-width="3" />
        <rect class="tray tray-p" x="-200" y="-92" width="532" height="184" rx="20" fill="var(--air)" />
        <g class="tray-icon">
          <path d="M-44 16 C-62 16 -62 -10 -42 -8 C-40 -30 -10 -34 -2 -16 C8 -30 34 -24 32 -6 C52 -8 54 16 36 16 Z" fill="#fff" stroke="#7FA7C2" stroke-width="5" stroke-linejoin="round" />
          <text class="tray-label" y="54" text-anchor="middle">Air</text>
        </g>
        <rect class="target-hl tray-l" x="-196" y="-176" width="392" height="352" rx="40" />
        <rect class="target-hl tray-p" x="-366" y="-126" width="732" height="252" rx="40" />
      </g></g>

      <!-- Deck -->
      <g data-static="deck" aria-hidden="true">
        <rect x="-104" y="-104" width="220" height="220" rx="24" fill="#F3E2C8" stroke={O} stroke-width="3" transform="rotate(6)" />
        <rect x="-112" y="-108" width="220" height="220" rx="24" fill="#F8EBD6" stroke={O} stroke-width="3" transform="rotate(-4)" />
      </g>

      <!-- Cards -->
      <g data-pieces>
        {CARDS.map((c) => (
          <g data-p={c.id} data-home={c.home} data-label={c.label} class="card is-waiting">
            <g class="lift">
              <rect class="card-bg" x="-110" y="-110" width="220" height="220" rx="24" fill="var(--paper)" stroke={O} stroke-width="3" />
              <g class="art">
                {c.id === 'elephant' && (
                  <g>
                    <ellipse cx="14" cy="16" rx="60" ry="42" fill="#A3ACB4" stroke={O} stroke-width="3" />
                    <g fill="#A3ACB4" stroke={O} stroke-width="3"><rect x="-22" y="40" width="20" height="40" rx="6" /><rect x="6" y="44" width="20" height="38" rx="6" /><rect x="36" y="40" width="20" height="40" rx="6" /><rect x="58" y="36" width="18" height="40" rx="6" /></g>
                    <path d="M72 6 C86 10 88 24 82 30" fill="none" stroke="#A3ACB4" stroke-width="5" stroke-linecap="round" />
                    <g class="anim" data-move="trunk"><path d="M-66 6 C-84 14 -88 44 -76 58 C-70 64 -62 60 -66 52" fill="none" stroke="#A3ACB4" stroke-width="15" stroke-linecap="round" /></g>
                    <circle cx="-46" cy="-6" r="32" fill="#A3ACB4" stroke={O} stroke-width="3" />
                    <ellipse cx="-26" cy="-4" rx="20" ry="28" fill="#BFC7CD" stroke={O} stroke-width="3" />
                    <circle cx="-58" cy="-14" r="4.5" fill={INK} />
                    <path d="M-62 14 C-58 22 -50 24 -44 22" fill="none" stroke="#FFF8EC" stroke-width="6" stroke-linecap="round" />
                  </g>
                )}
                {c.id === 'cow' && (
                  <g>
                    <g class="anim" data-move="tail"><path d="M66 0 C80 6 80 30 76 46" fill="none" stroke="#8B5A2B" stroke-width="5" stroke-linecap="round" /><path d="M76 44 L70 58 L82 56 Z" fill="#8B5A2B" /></g>
                    <rect x="-46" y="-22" width="114" height="64" rx="28" fill="#FFF8F0" stroke={O} stroke-width="3" />
                    <path d="M-10 -22 C0 -6 20 -10 26 -22 Z M30 20 C40 6 56 12 58 30 C46 40 34 36 30 20 Z" fill="#8B5A2B" />
                    <g fill="#FFF8F0" stroke={O} stroke-width="3"><rect x="-36" y="34" width="16" height="42" rx="5" /><rect x="-12" y="36" width="16" height="40" rx="5" /><rect x="34" y="36" width="16" height="40" rx="5" /><rect x="54" y="32" width="14" height="40" rx="5" /></g>
                    <path d="M-80 -42 C-82 -54 -76 -60 -70 -60 M-48 -42 C-46 -54 -52 -60 -58 -60" fill="none" stroke="#C9A46A" stroke-width="5" stroke-linecap="round" />
                    <ellipse cx="-64" cy="-14" rx="26" ry="30" fill="#FFF8F0" stroke={O} stroke-width="3" />
                    <ellipse cx="-64" cy="6" rx="18" ry="12" fill="#F4B5C4" stroke={O} stroke-width="2" />
                    <circle cx="-74" cy="-22" r="4" fill={INK} /><circle cx="-54" cy="-22" r="4" fill={INK} />
                  </g>
                )}
                {c.id === 'auto' && (
                  <g class="anim" data-move="wobble">
                    <path d="M-66 -40 C-62 -64 -44 -72 -20 -72 H58 C72 -72 80 -62 80 -48 V-40 Z" fill="#F6C343" stroke={O} stroke-width="3" stroke-linejoin="round" />
                    <path d="M80 -40 V30 H-40 C-66 30 -86 14 -88 -8 L-70 -40 Z" fill="#2E8540" stroke={O} stroke-width="3" stroke-linejoin="round" />
                    <path d="M-68 -38 L-56 -38 L-70 -10 L-84 -10 Z" fill="#CFE3EE" stroke={O} stroke-width="2.5" stroke-linejoin="round" />
                    <rect x="-36" y="-34" width="104" height="44" rx="10" fill="#FFF4DE" stroke={O} stroke-width="2.5" />
                    <rect x="28" y="-24" width="30" height="30" rx="5" fill="#8B5A2B" />
                    <path d="M-14 -34 V10" stroke={O} stroke-width="2.5" />
                    <path d="M-40 30 H80" stroke="#F6C343" stroke-width="6" />
                    <circle cx="-88" cy="-2" r="6" fill="#FFF1C6" stroke={O} stroke-width="2" />
                    <g fill="#4A3A2E" stroke={O} stroke-width="3"><circle cx="-58" cy="38" r="15" /><circle cx="54" cy="40" r="18" /></g>
                    <g fill="#C9CED3"><circle cx="-58" cy="38" r="6" /><circle cx="54" cy="40" r="7" /></g>
                  </g>
                )}
                {c.id === 'fish' && (
                  <g class="anim" data-move="wiggle">
                    <path d="M54 0 L92 -30 L88 0 L92 30 Z" fill="#F08A3C" stroke={O} stroke-width="3" stroke-linejoin="round" />
                    <ellipse cx="-4" cy="0" rx="66" ry="40" fill="#F6A04D" stroke={O} stroke-width="3" />
                    <path d="M-10 -38 C0 -58 24 -56 34 -34" fill="#F08A3C" stroke={O} stroke-width="3" />
                    <path d="M10 -26 C18 -10 18 10 10 26 M28 -22 C34 -8 34 8 28 22" fill="none" stroke="#E07A2E" stroke-width="4" stroke-linecap="round" />
                    <circle cx="-40" cy="-8" r="7" fill="#fff" /><circle cx="-41" cy="-8" r="4" fill={INK} />
                  </g>
                )}
                {c.id === 'dolphin' && (
                  <g>
                    <path d="M-90 62 C-60 52 -30 66 0 58 S60 50 90 60" fill="none" stroke="var(--water)" stroke-width="7" stroke-linecap="round" />
                    <g class="anim" data-move="arc">
                      <path d="M-82 30 C-60 -40 30 -64 76 -10 C84 0 80 10 70 6 C40 -16 0 -14 -30 10 L-20 40 L-44 26 L-62 44 L-58 20 Z" fill="#6F9FBF" stroke={O} stroke-width="3" stroke-linejoin="round" />
                      <path d="M-10 -38 L4 -66 L16 -40 Z" fill="#6F9FBF" stroke={O} stroke-width="3" stroke-linejoin="round" />
                      <path d="M-50 14 C-20 -4 20 -10 56 -2" fill="none" stroke="#D4EAF7" stroke-width="6" stroke-linecap="round" />
                      <circle cx="48" cy="-18" r="4.5" fill={INK} />
                    </g>
                  </g>
                )}
                {c.id === 'boat' && (
                  <g>
                    <path d="M-90 62 C-60 52 -30 66 0 58 S60 50 90 60" fill="none" stroke="var(--water)" stroke-width="7" stroke-linecap="round" />
                    <g class="anim" data-move="bob">
                      <path d="M4 34 V-78" stroke="#8B5A2B" stroke-width="6" stroke-linecap="round" />
                      <path d="M10 -70 C46 -40 56 -2 52 26 H10 Z" fill="#FFF4DE" stroke={O} stroke-width="3" stroke-linejoin="round" />
                      <g fill="#A0682E" stroke={O} stroke-width="3"><rect x="-84" y="26" width="168" height="16" rx="8" /><rect x="-78" y="38" width="156" height="16" rx="8" /><rect x="-70" y="50" width="140" height="14" rx="7" /></g>
                    </g>
                  </g>
                )}
                {c.id === 'parrot' && (
                  <g>
                    <path d="M18 40 L34 98 L6 50 Z" fill="#2E8540" stroke={O} stroke-width="3" stroke-linejoin="round" />
                    <ellipse cx="4" cy="12" rx="40" ry="52" fill="#3FA34D" stroke={O} stroke-width="3" />
                    <circle cx="-8" cy="-46" r="30" fill="#3FA34D" stroke={O} stroke-width="3" />
                    <path d="M-36 -48 C-52 -44 -54 -24 -40 -20 C-40 -30 -36 -36 -30 -38 Z" fill="#D9412F" stroke={O} stroke-width="3" stroke-linejoin="round" />
                    <circle cx="-14" cy="-54" r="5" fill={INK} />
                    <path d="M-30 -22 C-20 -16 -8 -18 4 -22" fill="none" stroke="#D9412F" stroke-width="5" stroke-linecap="round" />
                    <g class="anim" data-move="flap"><path d="M14 -8 C44 -4 50 40 30 64 C16 48 10 20 14 -8 Z" fill="#2E8540" stroke={O} stroke-width="3" stroke-linejoin="round" /></g>
                  </g>
                )}
                {c.id === 'plane' && (
                  <g class="anim" data-move="glide">
                    <path d="M-10 -6 L-40 -66 H-20 L30 -6 Z M-10 10 L-34 56 H-16 L30 10 Z" fill="#9CC8E8" stroke={O} stroke-width="3" stroke-linejoin="round" />
                    <path d="M-92 2 C-92 -16 -60 -18 -20 -18 H62 C80 -18 94 -8 94 2 C94 12 80 20 62 20 H-60 C-82 20 -92 14 -92 2 Z" fill="#FFFFFF" stroke={O} stroke-width="3" />
                    <path d="M-92 -2 L-100 -42 H-80 L-62 -16 Z" fill="#2F6FB0" stroke={O} stroke-width="3" stroke-linejoin="round" />
                    <path d="M-60 6 H70" stroke="#2F6FB0" stroke-width="6" />
                    <g fill="#CFE3EE"><circle cx="-30" cy="-6" r="5" /><circle cx="-10" cy="-6" r="5" /><circle cx="10" cy="-6" r="5" /><circle cx="30" cy="-6" r="5" /></g>
                    <path d="M70 -14 C82 -12 88 -6 90 0 H70 Z" fill="#CFE3EE" />
                  </g>
                )}
                {c.id === 'kite' && (
                  <g class="anim" data-move="flutter">
                    <path d="M0 -84 L56 -10 L0 50 L-56 -10 Z" fill="#F4B5C4" stroke={O} stroke-width="3" stroke-linejoin="round" />
                    <path d="M0 -84 L0 50 L-56 -10 Z" fill="#F29A6B" />
                    <path d="M0 -84 L56 -10 L0 50 L-56 -10 Z" fill="none" stroke={O} stroke-width="3" stroke-linejoin="round" />
                    <path d="M0 -84 V50 M-56 -10 H56" stroke="#8B5A2B" stroke-width="3" />
                    <path d="M0 50 C-14 64 14 74 0 88 C-12 98 8 104 4 108" fill="none" stroke="#8B5A2B" stroke-width="3" stroke-linecap="round" />
                    <g fill="#3F8F55"><path d="M-10 62 L0 68 L-10 74 Z M10 62 L0 68 L10 74 Z" /><path d="M-10 86 L0 92 L-10 98 Z M10 86 L0 92 L10 98 Z" /></g>
                  </g>
                )}
              </g>
            </g>
          </g>
        ))}
      </g>
      <HandLayer />
    </svg>
  </div>
</GameLayout>

<style>
  :global(svg[data-layout='portrait'] .tray-l), :global(svg[data-layout='landscape'] .tray-p) { display: none; }
  :global(svg[data-layout='landscape'] .tray-icon) { transform: translate(0px, -100px) scale(.85); }
  :global(svg[data-layout='portrait'] .tray-icon) { transform: translate(-272px, -8px); }
  :global(.tray-label) { font: 800 22px var(--font-body); fill: #5B4636; letter-spacing: .04em; }
  :global(.card.is-waiting) { display: none; }
  :global(.anim) { transform-box: fill-box; }
  :global([data-move='trunk']) { transform-origin: 100% 0%; }
  :global([data-move='tail']) { transform-origin: 0% 0%; }
  :global([data-move='wobble']), :global([data-move='bob']), :global([data-move='arc']), :global([data-move='glide']) { transform-origin: 50% 100%; }
  :global([data-move='wiggle']) { transform-origin: 50% 50%; }
  :global([data-move='flap']) { transform-origin: 20% 0%; }
  :global([data-move='flutter']) { transform-origin: 50% 0%; }
</style>

<script>
  import '../../games/land-air-water';
</script>
