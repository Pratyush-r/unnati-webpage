---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import PrinciplesWheel from '../components/PrinciplesWheel.astro';
import AreaCards from '../components/AreaCards.astro';
import Planes from '../components/Planes.astro';
import CompareToggle from '../components/CompareToggle.astro';
import FlipCards from '../components/FlipCards.astro';
import CtaBand from '../components/CtaBand.astro';
import { freedomQuote } from '../content/copy';
---
<BaseLayout
  title="Our Montessori Approach | Unnati Montessori, Chennai"
  description="Freedom within limits, the eight Montessori principles, the five curriculum areas and the four planes of development — how children learn at Unnati."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Our approach</p>
      <h1>Freedom, within clear limits</h1>
      <figure class="freedom" data-reveal>
        <blockquote>
          <p class="fq-lead">“{freedomQuote.lead}</p>
          <p class="fq-close">{freedomQuote.close}”</p>
        </blockquote>
      </figure>
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="principles">
    <div class="container">
      <SectionHead eyebrow="Montessori principles" title="Eight ideas that shape every day" id="principles" center
        intro="Tap, hover or focus a part of the wheel to read about it." />
      <PrinciplesWheel />
    </div>
  </section>

  <section class="section" aria-labelledby="five-areas">
    <div class="container">
      <SectionHead eyebrow="The curriculum" title="The five areas of a Montessori curriculum" id="five-areas"
        intro="Each area has its own shelf of real, beautiful materials — and its own activity in Little Hands Corner." />
      <AreaCards detail />
    </div>
  </section>

  <section class="section bg-paper" aria-labelledby="planes">
    <div class="container">
      <SectionHead eyebrow="The constructive rhythm of life" title="The four planes of development" id="planes"
        intro="Dr Montessori saw development as four planes of about six years each. Our children, 2½ to 6, are in the first: the absorbent mind." />
      <Planes />
    </div>
  </section>

  <section class="section bg-blush" id="compare" aria-labelledby="compare-title">
    <div class="container">
      <SectionHead eyebrow="Key differences" title="Montessori or traditional education?" id="compare-title" center />
      <CompareToggle split id="approach-compare" />
    </div>
  </section>

  <section class="section" id="did-you-know" aria-labelledby="dyk-title">
    <div class="container">
      <SectionHead eyebrow="Did you know?" title="Ten things about a Montessori classroom" id="dyk-title" intro="Tap a card to turn it over." />
      <FlipCards />
    </div>
  </section>

  <CtaBand title="See it for yourself." text="Call or WhatsApp us to talk about your child." />
</BaseLayout>

<style>
  .freedom { margin: 1.5rem 0 0; max-width: 900px; }
  .freedom blockquote { margin: 0; padding-left: clamp(1rem, .5rem + 2vw, 2rem); border-left: 4px solid var(--leaf); }
  .fq-lead { font-family: var(--font-head); font-size: clamp(1.35rem, 1.05rem + 1.3vw, 2rem); line-height: 1.3; color: var(--brown); font-weight: 500; max-width: 40ch; }
  .fq-close { margin-top: .9rem; font-size: var(--fs-lead); font-weight: 700; color: var(--forest); }
</style>
