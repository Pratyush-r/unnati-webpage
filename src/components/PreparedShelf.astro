---
// 4.4.1 Prepared Shelf — a child-height wooden shelf with one material per curriculum area.
// Each material is a real <button>; tap plays its mini-animation (≤ 900 ms) and opens one chip.
import MaterialArt from './illustrations/MaterialArt.astro';
import Ankur from './Ankur.astro';
import { areas } from '../content/copy';

const materials = areas.map((a) => ({
  ...a,
  label: { practical: 'Jug and glass on a tray', sensorial: 'Knobbed cylinders', language: 'Sandpaper letter "s"', maths: 'Spindle box', cultural: 'Land-and-water globe' }[a.id]!,
  chipMaterial: { practical: 'Jug and glass', sensorial: 'Knobbed cylinders', language: 'Sandpaper letter', maths: 'Spindle box', cultural: 'Globe' }[a.id]!,
  kind: a.id as 'practical' | 'sensorial' | 'language' | 'maths' | 'cultural',
}));
const tiers = [materials.slice(0, 3), materials.slice(3)];
---
<div class="shelf-wrap" data-shelf>
  <div class="shelf">
    <div class="shelf-top">
      <Ankur button size={70} class="shelf-ankur" label="Ankur, the Unnati sprout — tap to say hello" />
    </div>
    <div class="shelf-body">
      {tiers.map((tier, t) => (
        <div class="tier" data-tier={t}>
          {tier.map((m, i) => (
            <div class="cell" data-align={i === 0 ? 'start' : i === tier.length - 1 && tier.length > 1 ? 'end' : 'center'} data-pos={t * 3 + i}>
              <button
                type="button"
                class="material"
                data-material={m.kind}
                aria-expanded="false"
                aria-controls={`chip-${m.id}`}
                aria-label={`${m.label} — ${m.name}`}
              >
                <MaterialArt kind={m.kind} size={120} />
              </button>
              <div class="chip-pop" id={`chip-${m.id}`} hidden>
                <span class="chip-area">{m.name} · {m.chipMaterial}</span>
                <a href={m.href} class="chip-link">Try it <span aria-hidden="true">→</span><span class="sr-only">: {m.game}</span></a>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
  <p class="shelf-hint hand" data-shelf-hint>Tap something on the shelf</p>
</div>

<style>
  .shelf-wrap { position: relative; width: 100%; max-width: 560px; margin-inline: auto; }
  .shelf {
    position: relative; margin-top: 96px;
    background: linear-gradient(#F3E2C8, #EED7B7);
    border: 2px solid rgb(118 61 13 / .55); border-radius: 14px 14px 8px 8px;
    box-shadow: inset 0 0 0 10px var(--wood), inset 0 0 0 12px rgb(118 61 13 / .35), var(--shadow);
    padding: 12px 12px 0;
  }
  .shelf::after { /* feet */
    content: ''; position: absolute; left: 14px; right: 14px; bottom: -14px; height: 14px;
    background: linear-gradient(90deg, var(--wood-grain) 0 22px, transparent 22px calc(100% - 22px), var(--wood-grain) calc(100% - 22px));
    border-radius: 0 0 4px 4px;
  }
  .shelf-top { position: absolute; right: 18%; bottom: calc(100% - 4px); }
  .shelf-top :global(.shelf-ankur) { display: block; }
  .shelf-top::after { /* Ankur's shadow on the top board */
    content: ''; position: absolute; left: 50%; bottom: 0; width: 46px; height: 7px; transform: translateX(-50%);
    background: rgb(118 61 13 / .18); border-radius: 50%; z-index: -1;
  }
  .shelf-body { display: grid; }
  .tier {
    display: flex; justify-content: center; gap: 2px; padding: 10px 6px 0;
    border-bottom: 12px solid var(--wood); box-shadow: 0 2px 0 rgb(118 61 13 / .35);
    position: relative;
  }
  .tier + .tier { margin-top: 0; }
  .tier:last-child { border-bottom-width: 14px; }
  .cell { position: relative; flex: 0 1 33.333%; display: flex; justify-content: center; }
  .material {
    display: block; width: 100%; max-width: 128px; aspect-ratio: 1; padding: 6px 4px 0; border-radius: 14px;
    transition: transform 180ms var(--ease-pop), background-color 180ms ease;
  }
  .material:hover { background: rgb(255 250 242 / .55); }
  .material:active { transform: scale(.96); }
  .material[aria-expanded='true'] { background: rgb(255 250 242 / .75); }
  .material :global(svg) { width: 100%; height: 100%; }

  .chip-pop {
    position: absolute; bottom: calc(100% + 6px); z-index: 5; width: max-content; max-width: 230px;
    display: grid; gap: 2px; padding: .6rem .9rem .3rem; border-radius: 16px;
    background: var(--paper); border: 1px solid var(--line-strong); box-shadow: var(--shadow-lift);
    font-size: .875rem; line-height: 1.3;
  }
  .chip-pop[hidden] { display: none; }
  .cell[data-align='center'] .chip-pop { left: 50%; transform: translateX(-50%); }
  .cell[data-align='start'] .chip-pop { left: 0; }
  .cell[data-align='end'] .chip-pop { right: 0; }
  .chip-area { font-weight: 800; color: var(--ink); }
  .chip-link { display: inline-flex; align-items: center; gap: .3rem; min-height: 48px; font-weight: 800; color: var(--leaf); }
  .shelf-hint { text-align: center; margin: 1.6rem auto 0; color: var(--brown); }
  .shelf-hint.is-used { visibility: hidden; }

  @media (min-width: 768px) {
    .shelf-wrap { max-width: 640px; }
    .shelf-body { display: flex; justify-content: center; border-bottom: 14px solid var(--wood); box-shadow: 0 2px 0 rgb(118 61 13 / .35); }
    .tier { display: contents; }
    .cell { flex: 1 1 20%; padding-top: 12px; }
    .cell[data-pos='0'] { justify-content: flex-start; }
    .cell[data-pos='0'] .chip-pop { left: 0; transform: none; }
    .cell[data-pos='1'], .cell[data-pos='2'], .cell[data-pos='3'] { justify-content: center; }
    .cell[data-pos='2'] .chip-pop, .cell[data-pos='3'] .chip-pop { left: 50%; right: auto; transform: translateX(-50%); }
    .cell[data-pos='1'] .chip-pop { left: 50%; right: auto; transform: translateX(-50%); }
    .cell[data-pos='4'] .chip-pop { right: 0; left: auto; transform: none; }
  }
</style>

<script>
  import { animate, settle, EASE_POP } from '../lib/motion';
  import { play, initBlink } from './ankur';
  import { onPageLoad } from '../scripts/lifecycle';
  import { nurture } from '../scripts/nurture';

  onPageLoad(() => {
    const root = document.querySelector<HTMLElement>('[data-shelf]');
    if (!root) return;
    const ac = new AbortController();
    const signal = ac.signal;
    let stopBlink = () => {};
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.material'));
    const hint = root.querySelector<HTMLElement>('[data-shelf-hint]');
    const ankur = root.querySelector<HTMLElement>('[data-ankur]');
    if (ankur) {
      stopBlink = initBlink(ankur);
      ankur.addEventListener('click', () => {
        play(ankur, 'wave');
        nurture();
      }, { signal });
    }

    const closeAll = (except?: HTMLButtonElement) => {
      buttons.forEach((b) => {
        if (b === except) return;
        b.setAttribute('aria-expanded', 'false');
        const chip = document.getElementById(b.getAttribute('aria-controls')!);
        if (chip) chip.hidden = true;
      });
    };

    const run: Record<string, (svg: SVGElement) => void> = {
      practical(svg) {
        const water = svg.querySelector('.m-water');
        water?.setAttribute('style', 'transform: translateY(62%)');
        animate(svg.querySelector('.m-jug'), [
          { transform: 'rotate(0)' }, { transform: 'rotate(28deg)', offset: 0.3 }, { transform: 'rotate(28deg)', offset: 0.75 }, { transform: 'rotate(0)' },
        ], { duration: 880 });
        svg.querySelectorAll('.m-drop').forEach((d, i) =>
          animate(d, [{ opacity: 0, transform: 'translate(0,0)' }, { opacity: 1, transform: 'translate(2px,6px)', offset: 0.4 }, { opacity: 0, transform: 'translate(4px,18px)' }], { duration: 380, delay: 260 + i * 110 }),
        );
        settle(water, [{ transform: 'translateY(62%)' }, { transform: 'translateY(12%)' }], { duration: 480, delay: 300 });
      },
      sensorial(svg) {
        animate(svg.querySelector('.m-lift'), [
          { transform: 'translateY(0)' }, { transform: 'translateY(-22px)', offset: 0.35 }, { transform: 'translateY(-20px)', offset: 0.65 }, { transform: 'translateY(0)' },
        ], { duration: 860 });
      },
      language(svg) {
        const trace = svg.querySelector('.m-trace');
        animate(trace, [
          { strokeDashoffset: 100, opacity: 1 }, { strokeDashoffset: 0, opacity: 1, offset: 0.8 }, { strokeDashoffset: 0, opacity: 0 },
        ], { duration: 880, easing: 'ease-in-out' });
      },
      maths(svg) {
        const ribbon = svg.querySelector('.m-ribbon');
        ribbon?.setAttribute('stroke-dashoffset', '100');
        ribbon?.removeAttribute('style');
        animate(svg.querySelector('.m-bundle'), [
          { transform: 'translateY(0)' }, { transform: 'translateY(-14px)', offset: 0.25 }, { transform: 'translateY(0)', offset: 0.45 },
          { transform: 'translateY(-6px)', offset: 0.6 }, { transform: 'translateY(0)', offset: 0.72 },
        ], { duration: 520 });
        settle(ribbon, [{ strokeDashoffset: '100' }, { strokeDashoffset: '0' }], { duration: 360, delay: 520 });
      },
      cultural(svg) {
        animate(svg.querySelector('.m-land'), [{ transform: 'translateX(0)' }, { transform: 'translateX(-68px)' }], { duration: 900, easing: 'cubic-bezier(.45,.05,.35,1)' });
      },
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        hint?.classList.add('is-used');
        const open = btn.getAttribute('aria-expanded') !== 'true';
        closeAll(btn);
        btn.setAttribute('aria-expanded', String(open));
        const chip = document.getElementById(btn.getAttribute('aria-controls')!);
        if (chip) {
          chip.hidden = !open;
          if (open) animate(chip, [{ opacity: 0, translate: '0 6px', scale: '.94' }, { opacity: 1, translate: '0 0', scale: '1' }], { duration: 220, easing: EASE_POP });
        }
        const svg = btn.querySelector('svg');
        if (svg) run[btn.dataset.material!]?.(svg);
        nurture();
      }, { signal });
    });

    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('.chip-pop')) closeAll();
    }, { signal });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    }, { signal });
    return () => {
      ac.abort();
      stopBlink();
    };
  });
</script>
