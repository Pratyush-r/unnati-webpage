---
import ProgrammeArt from './illustrations/ProgrammeArt.astro';
import Icon from './Icon.astro';
import { programmes } from '../content/copy';
import { site, wa, waText } from '../config/site';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const tints: Record<string, string> = { primary: 'var(--sage)', daycare: 'var(--blush)', afterschool: 'var(--wheat)' };
const short: Record<string, string> = { primary: 'Primary', daycare: 'Day Care', afterschool: 'After-school' };
---
<ul class="programmes scatter" role="list" data-reveal="children">
  {programmes.map((p) => (
    <li class="programme pebble pebble--hover" id={`programme-${p.id}`}>
      <div class="art" style={`background:${tints[p.id]}`} transition:name={`programme-${p.id}`}><ProgrammeArt kind={p.id} size={84} /></div>
      <H class="p-title">{p.name}</H>
      {p.ages && <p class="chip p-ages">{p.ages}</p>}
      <p class="p-text">{p.text}</p>
      {p.more && <p class="p-more">{p.more}</p>}
      <div class="p-actions">
        <a class="btn btn--primary" href={wa(site.school, waText.programme(p.name))} target="_blank" rel="noopener">
          <Icon name="whatsapp" />WhatsApp about {short[p.id]}
        </a>
        {p.href && (
          <a class="text-link" href={p.href}>{p.id === 'daycare' ? `About ${site.dayCare.name}` : 'How it works'}<span aria-hidden="true">&nbsp;→</span></a>
        )}
      </div>
    </li>
  ))}
</ul>

<style>
  .programmes { display: grid; gap: clamp(1rem, .8rem + 1vw, 1.75rem); grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); align-items: start; }
  /* Uneven on purpose: the Primary Environment leads, the others sit lower and narrower. */
  @media (min-width: 1024px) {
    .programmes { grid-template-columns: 1.3fr 1fr 1fr; }
    .programme:nth-child(2) { margin-top: 3rem; }
    .programme:nth-child(3) { margin-top: 1.25rem; }
  }
  .programme { display: flex; flex-direction: column; gap: .6rem; }
  .art { border-radius: var(--r-md); display: grid; place-items: center; padding: .9rem; margin-bottom: .4rem; }
  .p-title { margin: 0; }
  .p-ages { width: fit-content; }
  .p-more { font-weight: 700; color: var(--brown); }
  .p-actions { margin-top: auto; padding-top: .5rem; display: flex; flex-wrap: wrap; gap: .25rem 1rem; align-items: center; }
</style>
