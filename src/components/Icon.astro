---
import { icons } from './icons';

interface Props {
  name: string;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 24, label, class: cls } = Astro.props;
const body = icons[name] ?? icons.leaf;
---
<svg
  class:list={['icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
