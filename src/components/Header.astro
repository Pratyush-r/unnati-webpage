---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, telHref, wa, waText } from '../config/site';

interface Props {
  path: string;
}
const { path } = Astro.props;
const number = site.school;
const waHref = wa(number, path === '/consultancy' ? waText.consultancy : waText.general);
const isHome = path === '/';
const enquireHref = isHome ? '#enquire' : '/admissions#enquire';

const links = [
  { href: '/about', label: 'About' },
  { href: '/approach', label: 'Our Approach' },
  { href: '/admissions', label: 'Admissions' },
  { href: '/day-care', label: 'Day Care' },
  { href: '/at-home', label: 'At Home' },
];
const educators = [
  { href: '/teach', label: 'Teach with Us' },
  { href: '/consultancy', label: 'Consultancy' },
];
const current = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);
const educatorsCurrent = educators.some((l) => current(l.href));
---
<header class="site-header" data-site-header transition:persist="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Unnati Montessori — home">
      <Logo class="brand-logo" />
    </a>

    <nav class="desktop-nav" aria-label="Main">
      <ul role="list">
        {links.map((l) => (
          <li>
            <a class="nav-link" href={l.href} aria-current={current(l.href)}>
              <span class="nl-text">{l.label}</span>
            </a>
          </li>
        ))}
        <li class="disclosure" data-disclosure>
          <button class="nav-link" type="button" aria-expanded="false" aria-controls="educators-menu" data-current={educatorsCurrent ? '' : undefined}>
            <span class="nl-text">For Educators</span>
            <Icon name="chevron-down" size={18} class="chev" />
          </button>
          <ul class="dropdown" id="educators-menu" role="list" hidden>
            {educators.map((l) => (
              <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>
            ))}
          </ul>
        </li>
        <li>
          <a class="nav-link" href="/contact" aria-current={current('/contact')}>
            <span class="nl-text">Contact</span>
          </a>
        </li>
      </ul>
    </nav>

    <a class="btn btn--primary enquire-btn" href={enquireHref} data-enquire>Enquire</a>

    <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="menu-sheet" data-menu-open>
      <Icon name="menu" size={26} />
      <span>Menu</span>
    </button>
  </div>

  <div class="nav-progress" data-nav-progress aria-hidden="true"><span class="np-bar"></span><span class="np-leaf"></span></div>

  <dialog class="sheet" id="menu-sheet" aria-label="Menu" data-menu-sheet>
    <div class="sheet-inner">
      <div class="sheet-top">
        <a href="/" class="brand" aria-label="Unnati Montessori — home"><Logo class="brand-logo" loading="lazy" /></a>
        <button class="menu-btn menu-btn--close" type="button" data-menu-close>
          <Icon name="close" size={26} />
          <span>Close</span>
        </button>
      </div>
      <nav aria-label="Main (mobile)">
        <ul role="list" class="sheet-links">
          <li><a href="/" aria-current={current('/') && isHome ? 'page' : undefined}>Home</a></li>
          {links.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
          {educators.map((l) => <li><a href={l.href} aria-current={current(l.href)}>{l.label}</a></li>)}
          <li><a href="/contact" aria-current={current('/contact')}>Contact</a></li>
        </ul>
      </nav>
      <a class="btn btn--secondary sheet-enquire" href={enquireHref} data-menu-close-link data-enquire>Send an enquiry</a>
      <div class="sheet-actions">
        <a class="btn btn--secondary" href={telHref(number)} data-contact="tel"><Icon name="phone" />Call</a>
        <a class="btn btn--primary" href={waHref} target="_blank" rel="noopener" data-contact="wa"><Icon name="whatsapp" />WhatsApp</a>
      </div>
    </div>
  </dialog>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 40;
    background: rgb(253 244 229 / .94);
    backdrop-filter: saturate(1.2) blur(8px);
    -webkit-backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner { display: flex; align-items: center; gap: 1rem; min-height: 72px; padding-block: 10px; }
  .nav-progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; pointer-events: none; opacity: 0; }
  .nav-progress.is-on { opacity: 1; }
  .np-bar { position: absolute; inset: 0; background: var(--brown); transform-origin: 0 50%; transform: scaleX(0); }
  .np-leaf {
    position: absolute; top: -4px; left: 0; width: 10px; height: 8px; background: var(--brown); border-radius: 0 100% 0 100%;
    transform: translateX(0) rotate(-20deg);
  }
  .brand { display: flex; align-items: center; flex: none; border-radius: 8px; }
  .brand :global(.brand-logo), .brand :global(.brand-logo img) { height: 52px; width: auto; }
  .desktop-nav { display: none; margin-left: auto; }
  .desktop-nav > ul { display: flex; align-items: center; gap: 0; }
  .nav-link {
    display: inline-flex; align-items: center; gap: .2rem; min-height: 48px; padding: 0 2px;
    color: var(--ink); font-weight: 700; font-size: .975rem; text-decoration: none; white-space: nowrap;
    border-radius: 10px;
  }
  .nav-link :global(.chev) { transition: transform 200ms var(--ease-move); }
  .nav-link[aria-expanded='true'] :global(.chev) { transform: rotate(180deg); }
  /* Hover/focus: text turns brown. Active page: brown text on a soft blush pill. No underlines. */
  .nav-link:hover, .nav-link:focus-visible, .nav-link[aria-expanded='true'] { color: var(--brown); }
  .nl-text { padding: 6px 12px; border-radius: 999px; transition: background-color 150ms ease; }
  .nav-link[aria-current='page'], .nav-link[data-current] { color: var(--brown); }
  .nav-link[aria-current='page'] .nl-text, .nav-link[data-current] .nl-text { background: var(--blush); }
  .disclosure { position: relative; }
  .dropdown {
    position: absolute; top: calc(100% + 6px); left: 0; min-width: 210px; padding: .5rem;
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-md); box-shadow: var(--shadow-lift);
  }
  .dropdown a {
    display: flex; align-items: center; min-height: 48px; padding: 0 1rem; border-radius: var(--r-sm);
    color: var(--ink); font-weight: 700; text-decoration: none;
  }
  .dropdown a:hover, .dropdown a[aria-current='page'] { background: var(--sage); color: var(--forest); }
  .enquire-btn { display: none; flex: none; }
  .menu-btn {
    margin-left: auto; display: inline-flex; align-items: center; gap: .4rem; min-height: 48px; min-width: 48px;
    padding: 0 .9rem; border-radius: 999px; border: 2px solid var(--line-strong); color: var(--brown); font-weight: 800;
    transition: transform 180ms var(--ease-pop);
  }
  .menu-btn:active { transform: scale(.96); }

  .sheet {
    margin: 0; padding: 0; border: 0; max-width: none; max-height: none; width: 100%; height: 100dvh;
    background: var(--cream); color: var(--ink);
  }
  .sheet::backdrop { background: rgb(59 36 20 / .35); }
  .sheet-inner {
    display: flex; flex-direction: column; min-height: 100%; gap: 1rem;
    padding: 10px var(--gutter) calc(20px + env(safe-area-inset-bottom));
  }
  .sheet-top { display: flex; align-items: center; justify-content: space-between; min-height: 52px; }
  .sheet-links { display: grid; gap: .1rem; margin-top: .5rem; }
  .sheet-links a {
    display: flex; align-items: center; min-height: 56px; padding: 0 .5rem; border-bottom: 1px solid var(--line);
    font-family: var(--font-head); font-size: 1.5rem; font-weight: 600; color: var(--brown); text-decoration: none;
  }
  .sheet-links a[aria-current='page'] { color: var(--brown); background: var(--blush); border-radius: 14px; }
  .sheet-enquire { margin-top: .5rem; }
  .sheet-actions { margin-top: auto; display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .sheet-actions .btn { min-height: 56px; }

  @media (min-width: 1024px) {
    .brand :global(.brand-logo), .brand :global(.brand-logo img) { height: 64px; }
    .header-inner { min-height: 84px; }
    .desktop-nav { display: block; }
    .enquire-btn { display: inline-flex; }
    .menu-btn:not(.menu-btn--close) { display: none; }
  }
  @media (min-width: 1024px) and (max-width: 1180px) {
    .nav-link { font-size: .925rem; }
    .nl-text { padding: 6px 9px; }
    .header-inner { gap: .5rem; }
  }
</style>

<script>
  import { animate } from '../lib/motion';
  import { initOnce, afterSwap } from '../scripts/lifecycle';
  import { applyContact, path } from '../scripts/route';

  // The header is persisted across navigations (transition:persist), so it initialises once
  // and refreshes its route-dependent parts after every swap.
  function refresh(header: HTMLElement): void {
    const p = path();
    const isCurrent = (href: string) => p === href || p.startsWith(href + '/');
    header.querySelectorAll<HTMLAnchorElement>('.desktop-nav a[href], .dropdown a[href], .sheet-links a[href]').forEach((a) => {
      const href = a.getAttribute('href')!;
      const on = href === '/' ? p === '/' : isCurrent(href);
      if (on) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    const edu = header.querySelector<HTMLElement>('[data-disclosure] > button');
    if (edu) {
      if (isCurrent('/teach') || isCurrent('/consultancy')) edu.dataset.current = '';
      else delete edu.dataset.current;
    }
    header.querySelectorAll<HTMLAnchorElement>('[data-enquire]').forEach((a) => (a.href = p === '/' ? '#enquire' : '/admissions#enquire'));
    applyContact(header);
  }

  initOnce('[data-site-header]', (header) => {
    // Mobile sheet: native <dialog> gives a focus trap, Esc to close and an inert background.
    const sheet = header.querySelector<HTMLDialogElement>('[data-menu-sheet]');
    const opener = header.querySelector<HTMLButtonElement>('[data-menu-open]');
    const lock = (on: boolean) => document.documentElement.classList.toggle('scroll-locked', on);
    opener?.addEventListener('click', () => {
      if (!sheet) return;
      sheet.showModal();
      lock(true);
      document.dispatchEvent(new CustomEvent('unnati:menu', { detail: true }));
      animate(sheet, [{ opacity: 0, transform: 'translateY(16px)' }, { opacity: 1, transform: 'none' }], { duration: 250 });
    });
    sheet?.addEventListener('close', () => {
      lock(false);
      document.dispatchEvent(new CustomEvent('unnati:menu', { detail: false }));
      if (!sheet.dataset.navigating) opener?.focus();
      delete sheet.dataset.navigating;
    });
    sheet?.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', () => sheet.close()));
    sheet?.querySelectorAll('.sheet-links a, [data-menu-close-link]').forEach((a) =>
      a.addEventListener('click', () => {
        sheet.dataset.navigating = '1';
        sheet.close();
      }),
    );

    // "For Educators" disclosure.
    header.querySelectorAll<HTMLElement>('[data-disclosure]').forEach((wrap) => {
      const btn = wrap.querySelector('button')!;
      const menu = wrap.querySelector<HTMLElement>('.dropdown')!;
      const set = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        menu.hidden = !open;
      };
      btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
      wrap.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !menu.hidden) {
          set(false);
          btn.focus();
        }
      });
      document.addEventListener('click', (e) => {
        if (!wrap.contains(e.target as Node)) set(false);
      });
      wrap.addEventListener('focusout', (e) => {
        if (!wrap.contains(e.relatedTarget as Node)) set(false);
      });
      document.addEventListener('astro:before-preparation', () => set(false));
    });

    refresh(header);
    afterSwap(() => refresh(header));
  });
</script>
