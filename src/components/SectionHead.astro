---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  center?: boolean;
  level?: 1 | 2;
  id?: string;
}
const { eyebrow, title, intro, center = false, level = 2, id } = Astro.props;
const H = level === 1 ? 'h1' : 'h2';
---
<div class:list={['section-head', { 'section-head--center': center }]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <H id={id}>{title}</H>
  {intro && <p>{intro}</p>}
  <slot />
</div>
