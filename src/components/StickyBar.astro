---
// Sticky action bar (< 768 px): [Call] [WhatsApp], safe-area aware.
import Icon from './Icon.astro';
import { site, telHref, wa, waText } from '../config/site';

const number = site.school;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const text = path === '/consultancy' ? waText.consultancy : waText.general;
---
<div class="sticky-bar" role="region" aria-label="Quick contact" data-action-bar transition:persist="action-bar">
  <a class="btn btn--secondary" href={telHref(number)} data-contact="tel"><Icon name="phone" />Call</a>
  <a class="btn btn--primary" href={wa(number, text)} target="_blank" rel="noopener" data-contact="wa"><Icon name="whatsapp" />WhatsApp</a>
</div>

<style>
  .sticky-bar {
    position: fixed; z-index: 30; left: 0; right: 0; bottom: 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
    padding: 8px 12px calc(8px + env(safe-area-inset-bottom));
    padding-left: max(12px, env(safe-area-inset-left)); padding-right: max(12px, env(safe-area-inset-right));
    background: color-mix(in srgb, var(--paper) 97%, transparent); border-top: 1px solid var(--line);
    box-shadow: 0 -10px 24px -18px rgb(118 61 13 / .45);
  }
  .sticky-bar .btn { min-height: 48px; }
  .sticky-bar .btn--secondary { background: var(--paper); }
  .sticky-bar[hidden] { display: none; }
  @media (min-width: 768px) { .sticky-bar { display: none; } }
</style>

<script>
  import { initOnce, afterSwap } from '../scripts/lifecycle';
  import { applyContact } from '../scripts/route';

  // Persisted: refresh its links after every swap.
  initOnce('[data-action-bar]', (bar) => {
    applyContact(bar);
    afterSwap(() => applyContact(bar));
  });
</script>
