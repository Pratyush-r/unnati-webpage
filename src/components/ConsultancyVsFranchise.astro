---
// 4.4.9 Consultancy vs franchise — two quotes, 8 benefit tiles, expandable trade-offs list.
import Icon from './Icon.astro';
import { consultancy } from '../content/faq';
---
<div class="cvf">
  <div class="quotes" data-reveal="children">
    <figure class="q q--franchise">
      <p class="q-label">Franchise</p>
      <blockquote>“{consultancy.franchiseQuote}”</blockquote>
      <svg viewBox="0 0 64 48" width="64" height="48" aria-hidden="true"><path d="M8 44V20L32 6l24 14v24z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" /><path d="M26 44V30h12v14M14 26h6M44 26h6" fill="none" stroke="currentColor" stroke-width="2.5" /><path d="M32 6V1h8v4h-8" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    </figure>
    <span class="vs" aria-hidden="true">vs</span>
    <figure class="q q--consult">
      <p class="q-label">Consultancy</p>
      <blockquote>“{consultancy.consultancyQuote}”</blockquote>
      <svg viewBox="0 0 64 48" width="64" height="48" aria-hidden="true"><path d="M32 40V22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /><path d="M32 24c0-9 6-14 15-14 0 9-6 14-15 14zM32 28c0-7-5-11-12-11 0 7 5 11 12 11z" fill="none" stroke="currentColor" stroke-width="2.5" /><path d="M10 34c6 0 10 4 14 8h16c4-4 8-8 14-8" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
    </figure>
  </div>

  <h3 class="tiles-title">How we're different</h3>
  <ul class="tiles" role="list" data-reveal="children">
    {consultancy.different.map((t, i) => (
      <li class="tile">
        <span class:list={['icon-badge', { 'icon-badge--blush': i % 2 === 1 }]}><Icon name={t.icon} /></span>
        <div>
          <h4>{t.title}</h4>
          <p>{t.text}</p>
        </div>
      </li>
    ))}
  </ul>

  <details class="tradeoffs">
    <summary>10 common franchise trade-offs</summary>
    <ol>
      {consultancy.tradeOffs.map((t) => <li>{t}</li>)}
    </ol>
  </details>
</div>

<style>
  .quotes { display: grid; gap: 1rem; align-items: stretch; }
  .q { margin: 0; border-radius: var(--r-pebble); padding: 1.5rem; display: grid; gap: .5rem; align-content: start; border: 1px solid var(--line); }
  .q svg { margin-top: .5rem; }
  .q--franchise { background: #EBD3BC; color: var(--brown); }
  .q--consult { background: var(--sage); color: var(--forest); }
  .q-label { font-weight: 800; letter-spacing: .1em; text-transform: uppercase; font-size: .875rem; }
  blockquote { margin: 0; font-family: var(--font-head); font-weight: 600; font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); line-height: 1.2; }
  .vs {
    justify-self: center; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%;
    background: var(--forest); color: var(--cream); font-weight: 800; margin-block: -1.75rem; z-index: 1; border: 4px solid var(--cream);
  }
  .tiles-title { margin: 2.5rem 0 1rem; }
  .tiles { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
  .tile { display: flex; gap: .9rem; align-items: flex-start; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-md); padding: 1rem; }
  .tile h4 { color: var(--forest); margin-bottom: .2rem; }
  .tile p { font-size: .975rem; }
  .tradeoffs { margin-top: 1.5rem; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-md); }
  .tradeoffs summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 56px; padding: 0 1.25rem; font-weight: 800; color: var(--brown); }
  .tradeoffs summary::-webkit-details-marker { display: none; }
  .tradeoffs summary::after { content: '+'; font-size: 1.5rem; line-height: 1; }
  .tradeoffs[open] summary::after { content: '−'; }
  .tradeoffs ol { padding: 0 1.25rem 1.25rem 2.75rem; display: grid; gap: .35rem; }
  @media (min-width: 768px) {
    .quotes { grid-template-columns: 1fr auto 1fr; align-items: center; }
    .vs { margin: 0 -1.75rem; }
    .tradeoffs ol { grid-template-columns: 1fr 1fr; column-gap: 2.5rem; }
  }
</style>
