---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Head from '../components/Head.astro';
import AnkurGuide from '../components/AnkurGuide.astro';
import { ClientRouter } from 'astro:transitions';
import { pageSlide } from '../transitions/animations';
import '../styles/transitions.css';
import '../styles/handmade.css';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description, jsonLd, noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en-IN">
  <head>
    <Head title={title} description={description} path={path} jsonLd={jsonLd} noindex={noindex} />
    <script is:inline define:vars={{ text: site.announcement }}>
      try { if (localStorage.getItem('unnati:announce') === text) document.documentElement.classList.add('announce-dismissed'); } catch (e) {}
    </script>
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <AnnouncementBar />
    <Header path={path} />
    <main id="main" tabindex="-1" transition:animate={pageSlide}>
      <slot />
    </main>
    <Footer />
    <StickyBar />
    <AnkurGuide path={path} />
    <script>
      import { initReveal } from '../lib/reveal';
      import { onPageLoad } from '../scripts/lifecycle';
      import '../scripts/transitions';
      import '../scripts/growth';
      onPageLoad(initReveal);
    </script>
  </body>
</html>

<style is:global>
  body.no-sticky { padding-bottom: 0; }
  main:focus { outline: none; }
</style>
