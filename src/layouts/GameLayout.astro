---
// Game shell shared by all five Little Hands Corner games: full viewport, no site chrome.
// Top bar: [Activities] · area + title · [Show me] · [Sound]. Board slot below. No ads, no tracking.
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/motion.css';
import Head from '../components/Head.astro';
import Icon from '../components/Icon.astro';
import Ankur from '../components/Ankur.astro';
import AnkurGuide from '../components/AnkurGuide.astro';
import MaterialArt from '../components/illustrations/MaterialArt.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/transitions.css';

interface Props {
  title: string;
  area: string;
  description: string;
  doneText: string;
  slug: 'set-the-table' | 'knobbed-cylinders' | 'sandpaper-letters' | 'spindle-box' | 'land-air-water';
}
const { title, area, description, doneText, slug } = Astro.props;
const kind = ({ 'set-the-table': 'practical', 'knobbed-cylinders': 'sensorial', 'sandpaper-letters': 'language', 'spindle-box': 'maths', 'land-air-water': 'cultural' } as const)[slug];
const path = Astro.url.pathname.replace(/\/$/, '');
---
<!doctype html>
<html lang="en-IN" class="game-html">
  <head>
    <Head title={`${title} · Little Hands Corner | Unnati Montessori`} description={description} path={path} />
    <ClientRouter fallback="animate" />
  </head>
  <body class="game-body">
    <div class="game" data-game={slug}>
      <header class="game-bar">
        <a class="g-btn" href="/play">
          <Icon name="activities" size={28} />
          <span class="g-lbl">Activities</span>
        </a>
        <span class="g-icon" aria-hidden="true" transition:name={`game-${slug}`}><MaterialArt kind={kind} size={44} /></span>
        <h1 class="g-title"><span class="g-area">{area}</span><span class="g-name">{title}</span></h1>
        <button type="button" class="g-btn" data-showme>
          <Icon name="showme" size={28} />
          <span class="g-lbl">Show me</span>
        </button>
        <button type="button" class="g-btn" data-sound aria-pressed="true">
          <span class="snd-on"><Icon name="sound-on" size={28} /></span>
          <span class="snd-off"><Icon name="sound-off" size={28} /></span>
          <span class="g-lbl" data-label>Sound on</span>
        </button>
      </header>

      <main class="game-main" id="main">
        <slot />
        <div class="game-ankur" data-game-ankur aria-hidden="true"><Ankur size={60} /></div>
        <div class="done-card" data-complete hidden>
          <p class="sr-only">{doneText}</p>
          <div class="done-actions">
            <button type="button" class="d-btn d-btn--again" data-again>
              <Icon name="again" size={32} /><span>Again</span>
            </button>
            <a class="d-btn" href="/play"><Icon name="activities" size={32} /><span>All activities</span></a>
          </div>
        </div>
      </main>
      <p class="sr-only" aria-live="polite" data-announce-region></p>
    </div>
    <AnkurGuide path={path} />
    <script>
      import '../scripts/transitions';
    </script>
  </body>
</html>

<style is:global>
  html.game-html, .game-body { height: 100%; overflow: hidden; overscroll-behavior: none; }
  .game-body { padding: 0; background: var(--cream); min-height: 0; }
  .game {
    height: 100dvh; display: flex; flex-direction: column; background: var(--cream);
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }
  .game-bar {
    flex: none; display: flex; align-items: center; gap: 8px; min-height: 56px; padding: 6px 10px;
    background: var(--paper); border-bottom: 1px solid var(--line);
  }
  .g-btn {
    flex: none; display: grid; justify-items: center; align-content: center; gap: 1px; min-width: 64px; min-height: 64px; padding: 4px 6px;
    border-radius: 18px; color: var(--brown); text-decoration: none; font-weight: 800; font-size: .6875rem; line-height: 1.1;
    transition: transform 180ms var(--ease-pop), background-color 150ms ease; touch-action: manipulation;
  }
  .g-btn:hover { background: rgb(118 61 13 / .07); }
  .g-btn:active { transform: scale(.96); }
  .g-btn[aria-disabled='true'] { opacity: .55; }
  .g-btn .snd-off { display: none; }
  .g-btn[data-on='false'] .snd-on { display: none; }
  .g-btn[data-on='false'] .snd-off { display: block; }
  .g-icon { flex: none; width: 44px; height: 44px; border-radius: 12px; background: var(--cream); display: grid; place-items: center; }
  .g-icon svg { width: 40px; height: 40px; }
  .g-title { flex: 1; min-width: 0; display: grid; text-align: center; font-size: 1rem; line-height: 1.15; }
  .g-area { font-family: var(--font-body); font-weight: 800; font-size: .6875rem; letter-spacing: .1em; text-transform: uppercase; color: var(--leaf); }
  .g-name { font-size: clamp(1.05rem, .9rem + .8vw, 1.5rem); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .game-main { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .board {
    position: relative; flex: 1; min-height: 0;
    touch-action: none; overscroll-behavior: contain; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
  }
  .board > svg { position: absolute; inset: 6px; width: calc(100% - 12px); height: calc(100% - 12px); display: block; overflow: visible; touch-action: none; -webkit-tap-highlight-color: transparent; }
  .board svg text { user-select: none; -webkit-user-select: none; }
  .game-ankur { position: absolute; left: 10px; bottom: 6px; pointer-events: none; z-index: 2; }

  /* Pieces & targets */
  .piece { cursor: grab; outline: none; }
  .piece.is-dragging { cursor: grabbing; }
  .piece .lift { transform-box: fill-box; transform-origin: center; transition: transform 150ms var(--ease-pop), filter 150ms ease; }
  .piece.is-held .lift { transform: scale(1.08); filter: drop-shadow(0 10px 7px rgb(118 61 13 / .32)); }
  .piece:focus-visible .lift { filter: drop-shadow(0 0 2px #0F692F) drop-shadow(0 0 2px #0F692F) drop-shadow(0 0 2px #0F692F); }
  .piece.is-locked { cursor: default; }
  .piece .hit { fill: transparent; }
  .target { outline: none; }
  .target .shim { transform-box: fill-box; transform-origin: center; }
  .target-hl { opacity: 0; transition: opacity 150ms ease; fill: none; stroke: var(--leaf); stroke-width: 6; stroke-dasharray: 2 12; stroke-linecap: round; }
  .target.is-candidate .target-hl { opacity: .65; }
  .target:focus-visible .target-hl { opacity: 1; stroke-dasharray: none; stroke-width: 7; }
  [data-hand], [data-ghost] { pointer-events: none; }
  [data-hand] .finger2 { display: none; }
  [data-hand].two-fingers .finger2 { display: inline; }

  /* Completion */
  .done-card {
    position: absolute; left: 50%; bottom: max(16px, env(safe-area-inset-bottom)); transform: translateX(-50%); z-index: 3;
    background: var(--paper); border: 1px solid var(--line-strong); border-radius: 28px; box-shadow: var(--shadow-lift); padding: 12px;
  }
  .done-card[hidden] { display: none; }
  .done-actions { display: flex; gap: 12px; }
  .d-btn {
    display: grid; justify-items: center; align-content: center; gap: 2px; min-width: 96px; min-height: 76px; padding: 8px 14px;
    border-radius: 20px; font-weight: 800; font-size: .875rem; color: var(--brown); text-decoration: none; background: var(--cream);
    border: 2px solid var(--line-strong); transition: transform 180ms var(--ease-pop); touch-action: manipulation;
  }
  .d-btn:active { transform: scale(.96); }
  .d-btn--again { background: var(--forest); color: var(--cream); border-color: var(--forest); }
  @media (max-width: 420px) { .g-btn .g-lbl { font-size: .625rem; } .g-name { font-size: 1rem; } }
  /* Phone landscape: the bar becomes a slim side rail so the board keeps its height. */
  @media (orientation: landscape) and (max-height: 500px) {
    .game { flex-direction: row; }
    .game-bar { flex-direction: column; justify-content: flex-start; width: 80px; min-height: 0; padding: 6px 4px; border-bottom: 0; border-right: 1px solid var(--line); }
    .g-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .game-ankur { left: auto; right: 8px; }
  }
</style>
