# Copy this file to .env and fill it in. Never commit .env (git ignores it).
# In production, add the same names in Netlify → Site configuration → Environment variables.

# Your website address (used for links, the sitemap and share previews).
SITE_URL=https://unnati-montessori.netlify.app

# Optional: log enquiries to a Google Sheet / Notion via a webhook.
PUBLIC_ENQUIRY_WEBHOOK_URL=

# ——— Online fee payments (prototype) ———
# Which adapter in src/lib/payments/providers/ to use. Only "mock" exists today (demo, no real money).
PAYMENT_PROVIDER=mock
# From the gateway dashboard once one is chosen. Leave empty for the mock.
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
# Secret used to verify webhook signatures (set in the gateway's webhook settings).
PAYMENT_WEBHOOK_SECRET=
# Where the mock keeps orders locally. Default: .data/mock-orders.json
PAYMENT_STORE_FILE=
